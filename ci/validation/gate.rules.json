{
  "rules": [
    {
      "path": "enabled.repository",
      "enum": [
        "true",
        "false"
      ]
    },
    {
      "path": "enabled.pages",
      "enum": [
        "true",
        "false"
      ]
    },
    {
      "path": "enabled.release",
      "enum": [
        "true",
        "false"
      ]
    },
    {
      "path": "enabled.images",
      "enum": [
        "true",
        "false"
      ]
    },
    {
      "path": "results.validate.result",
      "equals": "success"
    },
    {
      "path": "results.build.result",
      "equals": "success"
    },
    {
      "path": "results.repository.result",
      "equals": "success",
      "when": {
        "path": "enabled.repository",
        "equals": "true"
      }
    },
    {
      "path": "results.repository.result",
      "equals": "skipped",
      "when": {
        "path": "enabled.repository",
        "equals": "false"
      }
    },
    {
      "path": "results.pages.result",
      "equals": "success",
      "when": {
        "path": "enabled.pages",
        "equals": "true"
      }
    },
    {
      "path": "results.pages.result",
      "equals": "skipped",
      "when": {
        "path": "enabled.pages",
        "equals": "false"
      }
    },
    {
      "path": "results.release.result",
      "equals": "success",
      "when": {
        "path": "enabled.release",
        "equals": "true"
      }
    },
    {
      "path": "results.release.result",
      "equals": "skipped",
      "when": {
        "path": "enabled.release",
        "equals": "false"
      }
    },
    {
      "path": "results.images.result",
      "equals": "success",
      "when": {
        "path": "enabled.images",
        "equals": "true"
      }
    },
    {
      "path": "results.images.result",
      "equals": "skipped",
      "when": {
        "path": "enabled.images",
        "equals": "false"
      }
    }
  ]
}
