{
  "rules": [
    {
      "path": "images",
      "kind": "array",
      "min_items": 1,
      "unique_by": "name"
    },
    {
      "path": "targets",
      "kind": "array",
      "min_items": 1,
      "unique_by": "name"
    },
    {
      "path": "images.*",
      "kind": "object"
    },
    {
      "path": "images.*.name",
      "kind": "string",
      "pattern": "^[a-z0-9][a-z0-9%-]*$",
      "min_length": 1
    },
    {
      "path": "images.*.runner",
      "kind": "string",
      "enum": [
        "ubuntu-24.04",
        "ubuntu-24.04-arm",
        "windows-2025",
        "windows-11-arm",
        "macos-15-intel",
        "macos-15"
      ]
    },
    {
      "path": "images.*.profile",
      "kind": "string",
      "enum": [
        "gcc",
        "clang",
        "rust",
        "mingw",
        "msvc"
      ]
    },
    {
      "path": "images.*.platform",
      "kind": "string",
      "enum": [
        "",
        "linux/amd64",
        "linux/arm64"
      ]
    },
    {
      "path": "images.*.probes",
      "kind": "array",
      "min_items": 1
    },
    {
      "path": "images.*.probes.*.argv",
      "kind": "array",
      "min_items": 1
    },
    {
      "path": "images.*.probes.*.argv.*",
      "kind": "string"
    },
    {
      "path": "images.*.probes.*.code",
      "kind": "number"
    },
    {
      "path": "targets.*",
      "kind": "object"
    },
    {
      "path": "targets.*.name",
      "kind": "string",
      "pattern": "^[a-z0-9][a-z0-9%-]*$",
      "min_length": 1
    },
    {
      "path": "targets.*.runner",
      "kind": "string",
      "enum": [
        "ubuntu-24.04",
        "ubuntu-24.04-arm",
        "windows-2025",
        "windows-11-arm",
        "macos-15-intel",
        "macos-15"
      ]
    },
    {
      "path": "targets.*.profile",
      "kind": "string",
      "enum": [
        "gcc",
        "clang",
        "rust",
        "mingw",
        "msvc"
      ]
    },
    {
      "path": "targets.*.platform",
      "kind": "string",
      "enum": [
        "",
        "linux/amd64",
        "linux/arm64"
      ]
    },
    {
      "path": "targets.*.probes",
      "kind": "array",
      "min_items": 1
    },
    {
      "path": "targets.*.probes.*.argv",
      "kind": "array",
      "min_items": 1
    },
    {
      "path": "targets.*.probes.*.argv.*",
      "kind": "string"
    },
    {
      "path": "targets.*.probes.*.code",
      "kind": "number"
    },
    {
      "path": "images.*.base",
      "kind": "string",
      "capture_pattern": "@sha256:([a-f0-9]+)$",
      "capture_length": 64
    },
    {
      "path": "images.*.recipe",
      "kind": "string",
      "prefix": "linux/",
      "reject_substrings": [
        "..",
        "\\"
      ]
    },
    {
      "path": "images.*.packages",
      "kind": "array",
      "min_items": 1
    },
    {
      "path": "images.*.packages.*",
      "kind": "string",
      "min_length": 1
    },
    {
      "path": "images.*.common_packages",
      "kind": "array",
      "min_items": 1
    },
    {
      "path": "images.*.common_packages.*",
      "kind": "string",
      "min_length": 1
    },
    {
      "path": "images.*.inventory",
      "kind": "array",
      "min_items": 1
    },
    {
      "path": "images.*.inventory.*",
      "kind": "string",
      "min_length": 1
    },
    {
      "path": "images.*.packages.*",
      "kind": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9%+%.%-]*$"
    },
    {
      "path": "images.*.common_packages.*",
      "kind": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9%+%.%-]*$"
    },
    {
      "path": "targets.*.image",
      "kind": "string"
    },
    {
      "path": "targets.*.target",
      "kind": "string",
      "min_length": 1
    },
    {
      "path": "targets.*.environment",
      "kind": "object"
    },
    {
      "path": "targets.*.environment.*",
      "kind": "string"
    },
    {
      "path": "targets.*.probes.*.stdout_contains",
      "kind": "string",
      "optional": true
    },
    {
      "path": "images.*.platform",
      "kind": "string",
      "enum": [
        "linux/amd64",
        "linux/arm64"
      ]
    },
    {
      "path": "images.*.profile",
      "kind": "string",
      "enum": [
        "gcc",
        "clang",
        "rust",
        "mingw"
      ]
    },
    {
      "path": "images.*.distro",
      "kind": "string",
      "enum": [
        "alpine",
        "debian",
        "ubuntu",
        "fedora",
        "arch"
      ]
    },
    {
      "path": "targets.*.reuse_identity",
      "kind": "string",
      "enum": [
        "exact_commit",
        "source_tree"
      ],
      "optional": true
    },
    {
      "path": "targets.*.reproducible",
      "kind": "boolean",
      "optional": true
    }
  ],
  "relations": [
    {
      "source": "targets",
      "field": "image",
      "destination": "images",
      "key": "name",
      "skip": "",
      "equal_fields": [
        "platform",
        "profile",
        "runner"
      ]
    },
    {
      "source": "config.images.names",
      "destination": "images",
      "key": "name"
    },
    {
      "source": "config.build.targets",
      "destination": "targets",
      "key": "name"
    },
    {
      "source": "selected",
      "field": "image",
      "destination": "config.images.names",
      "skip": "",
      "enabled_path": "config.images.enabled"
    },
    {
      "source": "selected",
      "field": "image",
      "destination": "images",
      "key": "name",
      "skip": "",
      "equal_fields": [
        "platform",
        "profile",
        "runner"
      ]
    }
  ],
  "paths": [
    {
      "source": "images",
      "template": "ci/images/{recipe}"
    },
    {
      "source": "images",
      "template": "ci/images/toolchains/{profile}/Dockerfile"
    }
  ],
  "collections": [
    {
      "path": "images",
      "rules": [
        {
          "path": "platform",
          "equals": "linux/amd64",
          "when": {
            "path": "distro",
            "equals": "arch"
          }
        },
        {
          "path": "runner",
          "equals": "ubuntu-24.04",
          "when": {
            "path": "platform",
            "equals": "linux/amd64"
          }
        },
        {
          "path": "runner",
          "equals": "ubuntu-24.04-arm",
          "when": {
            "path": "platform",
            "equals": "linux/arm64"
          }
        }
      ]
    }
  ]
}
