{
  "repository": {
    "checks": [
      {
        "operation": "directory_entries",
        "path": ".github/workflows",
        "expected": [
          "ci.yml"
        ]
      },
      {
        "operation": "absent_files",
        "paths": [
          "ci/pipeline.luau",
          ".github/pipeline.luau"
        ]
      },
      {
        "operation": "existing_config_paths",
        "config_path": "repository.include"
      },
      {
        "operation": "file_contains",
        "path": ".gitignore",
        "text": "/build/"
      }
    ]
  },
  "catalogue": {
    "rules": {
      "rules": [
        {
          "path": "images",
          "kind": "array",
          "min_items": 1,
          "unique_by": "name"
        },
        {
          "path": "targets",
          "kind": "array",
          "min_items": 1,
          "unique_by": "name"
        },
        {
          "path": "images.*",
          "kind": "object"
        },
        {
          "path": "images.*.name",
          "kind": "string",
          "pattern": "^[a-z0-9][a-z0-9%-]*$",
          "min_length": 1
        },
        {
          "path": "images.*.runner",
          "kind": "string",
          "enum": [
            "ubuntu-24.04",
            "ubuntu-24.04-arm",
            "windows-2025",
            "windows-11-arm",
            "macos-15-intel",
            "macos-15"
          ]
        },
        {
          "path": "images.*.profile",
          "kind": "string",
          "enum": [
            "gcc",
            "clang",
            "rust",
            "mingw",
            "msvc"
          ]
        },
        {
          "path": "images.*.platform",
          "kind": "string",
          "enum": [
            "",
            "linux/amd64",
            "linux/arm64"
          ]
        },
        {
          "path": "images.*.probes",
          "kind": "array",
          "min_items": 1
        },
        {
          "path": "images.*.probes.*.argv",
          "kind": "array",
          "min_items": 1
        },
        {
          "path": "images.*.probes.*.argv.*",
          "kind": "string"
        },
        {
          "path": "images.*.probes.*.code",
          "kind": "number"
        },
        {
          "path": "targets.*",
          "kind": "object"
        },
        {
          "path": "targets.*.name",
          "kind": "string",
          "pattern": "^[a-z0-9][a-z0-9%-]*$",
          "min_length": 1
        },
        {
          "path": "targets.*.runner",
          "kind": "string",
          "enum": [
            "ubuntu-24.04",
            "ubuntu-24.04-arm",
            "windows-2025",
            "windows-11-arm",
            "macos-15-intel",
            "macos-15"
          ]
        },
        {
          "path": "targets.*.profile",
          "kind": "string",
          "enum": [
            "gcc",
            "clang",
            "rust",
            "mingw",
            "msvc"
          ]
        },
        {
          "path": "targets.*.platform",
          "kind": "string",
          "enum": [
            "",
            "linux/amd64",
            "linux/arm64"
          ]
        },
        {
          "path": "targets.*.probes",
          "kind": "array",
          "min_items": 1
        },
        {
          "path": "targets.*.probes.*.argv",
          "kind": "array",
          "min_items": 1
        },
        {
          "path": "targets.*.probes.*.argv.*",
          "kind": "string"
        },
        {
          "path": "targets.*.probes.*.code",
          "kind": "number"
        },
        {
          "path": "images.*.base",
          "kind": "string",
          "capture_pattern": "@sha256:([a-f0-9]+)$",
          "capture_length": 64
        },
        {
          "path": "images.*.recipe",
          "kind": "string",
          "prefix": "linux/",
          "reject_substrings": [
            "..",
            "\\"
          ]
        },
        {
          "path": "images.*.packages",
          "kind": "array",
          "min_items": 1
        },
        {
          "path": "images.*.packages.*",
          "kind": "string",
          "min_length": 1
        },
        {
          "path": "images.*.common_packages",
          "kind": "array",
          "min_items": 1
        },
        {
          "path": "images.*.common_packages.*",
          "kind": "string",
          "min_length": 1
        },
        {
          "path": "images.*.inventory",
          "kind": "array",
          "min_items": 1
        },
        {
          "path": "images.*.inventory.*",
          "kind": "string",
          "min_length": 1
        },
        {
          "path": "images.*.packages.*",
          "kind": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9%+%.%-]*$"
        },
        {
          "path": "images.*.common_packages.*",
          "kind": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9%+%.%-]*$"
        },
        {
          "path": "targets.*.image",
          "kind": "string"
        },
        {
          "path": "targets.*.target",
          "kind": "string",
          "min_length": 1
        },
        {
          "path": "targets.*.environment",
          "kind": "object"
        },
        {
          "path": "targets.*.environment.*",
          "kind": "string"
        },
        {
          "path": "targets.*.probes.*.stdout_contains",
          "kind": "string",
          "optional": true
        },
        {
          "path": "images.*.platform",
          "kind": "string",
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        },
        {
          "path": "images.*.profile",
          "kind": "string",
          "enum": [
            "gcc",
            "clang",
            "rust",
            "mingw"
          ]
        },
        {
          "path": "images.*.distro",
          "kind": "string",
          "enum": [
            "alpine",
            "debian",
            "ubuntu",
            "fedora",
            "arch"
          ]
        },
        {
          "path": "targets.*.reuse_identity",
          "kind": "string",
          "enum": [
            "exact_commit",
            "source_tree"
          ],
          "optional": true
        },
        {
          "path": "targets.*.reproducible",
          "kind": "boolean",
          "optional": true
        }
      ],
      "relations": [
        {
          "source": "targets",
          "field": "image",
          "destination": "images",
          "key": "name",
          "skip": "",
          "equal_fields": [
            "platform",
            "profile",
            "runner"
          ]
        },
        {
          "source": "config.images.names",
          "destination": "images",
          "key": "name"
        },
        {
          "source": "config.build.targets",
          "destination": "targets",
          "key": "name"
        },
        {
          "source": "selected",
          "field": "image",
          "destination": "config.images.names",
          "skip": "",
          "enabled_path": "config.images.enabled"
        },
        {
          "source": "selected",
          "field": "image",
          "destination": "images",
          "key": "name",
          "skip": "",
          "equal_fields": [
            "platform",
            "profile",
            "runner"
          ]
        }
      ],
      "paths": [
        {
          "source": "images",
          "template": "ci/images/{recipe}"
        },
        {
          "source": "images",
          "template": "ci/images/toolchains/{profile}/Dockerfile"
        }
      ],
      "collections": [
        {
          "path": "images",
          "rules": [
            {
              "path": "platform",
              "equals": "linux/amd64",
              "when": {
                "path": "distro",
                "equals": "arch"
              }
            },
            {
              "path": "runner",
              "equals": "ubuntu-24.04",
              "when": {
                "path": "platform",
                "equals": "linux/amd64"
              }
            },
            {
              "path": "runner",
              "equals": "ubuntu-24.04-arm",
              "when": {
                "path": "platform",
                "equals": "linux/arm64"
              }
            }
          ]
        }
      ]
    },
    "cases": {
      "cases": [
        {
          "name": "baseline",
          "valid": true
        },
        {
          "name": "unknown image",
          "valid": false,
          "patch": {
            "config.images.names": [
              "missing"
            ]
          }
        },
        {
          "name": "unknown target",
          "valid": false,
          "patch": {
            "config.build.targets": [
              "missing"
            ]
          }
        },
        {
          "name": "missing selected image",
          "valid": false,
          "patch": {
            "config.images.names": []
          }
        },
        {
          "name": "image jobs disabled",
          "valid": false,
          "patch": {
            "config.images.enabled": false
          }
        },
        {
          "name": "duplicate image",
          "valid": false,
          "patch": {
            "images": []
          }
        },
        {
          "name": "native only without images",
          "valid": true,
          "patch": {
            "config.build.targets": [
              "windows-msvc-x64"
            ],
            "config.images.names": [],
            "config.images.enabled": false
          }
        },
        {
          "name": "invalid platform",
          "valid": false,
          "patch": {
            "images.1.platform": "linux/mips"
          }
        },
        {
          "name": "invalid package expression",
          "valid": false,
          "patch": {
            "images.1.packages": [
              "gcc; exit 0"
            ]
          }
        },
        {
          "name": "unmatched runner architecture",
          "valid": false,
          "patch": {
            "images.1.runner": "ubuntu-24.04-arm"
          }
        },
        {
          "name": "missing base digest",
          "valid": false,
          "patch": {
            "images.1.base": "alpine:latest"
          }
        },
        {
          "name": "escaping recipe",
          "valid": false,
          "patch": {
            "images.1.recipe": "linux/../../Dockerfile"
          }
        },
        {
          "name": "target image mismatch",
          "valid": false,
          "patch": {
            "targets.1.profile": "clang"
          }
        }
      ],
      "baseline": {
        "patch": {
          "config.build.matrix": [],
          "config.build.targets": [
            "alpine-gcc-x64"
          ],
          "config.images.names": [
            "alpine-gcc-x64"
          ],
          "config.images.enabled": true
        }
      }
    }
  },
  "config": {
    "rules": {
      "description": "Template-owned validation rules. Patterns use Luau string patterns, not regular expressions.",
      "definitions": {
        "relative": {
          "kind": "string",
          "min_length": 1,
          "reject_substrings": [
            "\\",
            ":",
            "//"
          ],
          "reject_patterns": [
            "^/",
            "/$",
            "[%c]"
          ],
          "forbidden_components": [
            ".",
            ".."
          ]
        }
      },
      "rules": [
        {
          "path": "$",
          "kind": "object"
        },
        {
          "path": "repository",
          "kind": "object"
        },
        {
          "path": "repository.enabled",
          "kind": "boolean"
        },
        {
          "path": "repository.publish",
          "kind": "boolean"
        },
        {
          "path": "repository.enabled",
          "equals": true,
          "when": {
            "path": "repository.publish",
            "equals": true
          },
          "message": "repository cannot publish while disabled"
        },
        {
          "path": "pages",
          "kind": "object"
        },
        {
          "path": "pages.enabled",
          "kind": "boolean"
        },
        {
          "path": "pages.publish",
          "kind": "boolean"
        },
        {
          "path": "pages.enabled",
          "equals": true,
          "when": {
            "path": "pages.publish",
            "equals": true
          },
          "message": "pages cannot publish while disabled"
        },
        {
          "path": "release",
          "kind": "object"
        },
        {
          "path": "release.enabled",
          "kind": "boolean"
        },
        {
          "path": "release.publish",
          "kind": "boolean"
        },
        {
          "path": "release.enabled",
          "equals": true,
          "when": {
            "path": "release.publish",
            "equals": true
          },
          "message": "release cannot publish while disabled"
        },
        {
          "path": "images",
          "kind": "object"
        },
        {
          "path": "images.enabled",
          "kind": "boolean"
        },
        {
          "path": "images.publish",
          "kind": "boolean",
          "default": false,
          "equals": false,
          "message": "CI images are workflow artifacts; registry publication is retired"
        },
        {
          "path": "images.enabled",
          "equals": true,
          "when": {
            "path": "images.publish",
            "equals": true
          },
          "message": "images cannot publish while disabled"
        },
        {
          "path": "repository.include",
          "kind": "array"
        },
        {
          "path": "repository.include.*",
          "use": "relative",
          "not_values": [
            "build",
            ".git"
          ],
          "reject_patterns": [
            "^build/",
            "^%.git/"
          ]
        },
        {
          "path": "pages.title",
          "kind": "string",
          "default": "Project documentation"
        },
        {
          "path": "images.names",
          "kind": "array",
          "unique": true,
          "default": []
        },
        {
          "path": "images.names.*",
          "kind": "string",
          "pattern": "^[a-z][a-z0-9%-]*$"
        },
        {
          "path": "images.names",
          "min_items": 1,
          "when": {
            "path": "images.enabled",
            "equals": true
          }
        },
        {
          "path": "build",
          "kind": "object"
        },
        {
          "path": "build.runner",
          "kind": "string",
          "enum": [
            "ubuntu-latest",
            "windows-latest",
            "macos-latest",
            "ubuntu-24.04",
            "ubuntu-24.04-arm",
            "windows-2025",
            "windows-11-arm",
            "macos-15",
            "macos-15-intel"
          ],
          "default": "ubuntu-latest"
        },
        {
          "path": "build.rust_version",
          "kind": "string",
          "default": ""
        },
        {
          "path": "build.cmake_version",
          "kind": "string",
          "default": ""
        },
        {
          "path": "build.toolchains",
          "kind": "array",
          "default": []
        },
        {
          "path": "build.toolchains.*",
          "kind": "string",
          "enum": [
            "rust",
            "cmake"
          ]
        },
        {
          "path": "build.rust_version",
          "pattern": "^%d+%.%d+%.%d+$",
          "when": {
            "path": "build.toolchains",
            "contains": "rust"
          }
        },
        {
          "path": "build.cmake_version",
          "pattern": "^%d+%.%d+%.%d+$",
          "when": {
            "path": "build.toolchains",
            "contains": "cmake"
          }
        },
        {
          "path": "build.commands",
          "kind": "array",
          "default": []
        },
        {
          "path": "build.commands.*",
          "kind": "array",
          "min_items": 1
        },
        {
          "path": "build.commands.*.*",
          "kind": "string"
        },
        {
          "path": "build.commands.*.1",
          "kind": "string",
          "min_length": 1
        },
        {
          "path": "build.package_paths",
          "kind": "array",
          "default": []
        },
        {
          "path": "build.package_paths.*",
          "use": "relative",
          "prefix": "build/",
          "not_values": [
            "build/artifacts",
            "build/manifest.json",
            "build/distribution.tar.gz",
            "build/provenance.json"
          ],
          "reject_patterns": [
            "^build/artifacts/"
          ]
        },
        {
          "path": "build.matrix",
          "kind": "array",
          "unique_by": "name",
          "default": []
        },
        {
          "path": "build.matrix.*",
          "kind": "object"
        },
        {
          "path": "build.matrix.*.name",
          "kind": "string",
          "pattern": "^[a-z][a-z0-9%-]*$"
        },
        {
          "path": "build.matrix.*.runner",
          "kind": "string",
          "enum": [
            "ubuntu-latest",
            "windows-latest",
            "macos-latest",
            "ubuntu-24.04",
            "ubuntu-24.04-arm",
            "windows-2025",
            "windows-11-arm",
            "macos-15",
            "macos-15-intel"
          ]
        },
        {
          "path": "build.targets",
          "kind": "array",
          "unique": true,
          "default": []
        },
        {
          "path": "build.targets.*",
          "kind": "string",
          "pattern": "^[a-z][a-z0-9%-]*$"
        },
        {
          "path": "build.matrix.*.image",
          "kind": "string",
          "optional": true
        },
        {
          "path": "build.matrix.*.platform",
          "kind": "string",
          "optional": true
        },
        {
          "path": "build.matrix.*.profile",
          "kind": "string",
          "optional": true
        },
        {
          "path": "build.matrix.*.target",
          "kind": "string",
          "optional": true
        },
        {
          "path": "build.matrix.*.rust_version",
          "kind": "string",
          "optional": true
        },
        {
          "path": "build.matrix.*.msvc_arch",
          "kind": "string",
          "optional": true
        },
        {
          "path": "build.matrix.*.environment",
          "kind": "object",
          "optional": true
        },
        {
          "path": "build.matrix.*.probes",
          "kind": "array",
          "optional": true
        },
        {
          "path": "build.matrix.*.environment.*",
          "kind": "string",
          "optional": true
        },
        {
          "path": "build.matrix.*.probes.*.argv",
          "kind": "array",
          "min_items": 1,
          "optional": true
        },
        {
          "path": "build.matrix.*.probes.*.argv.*",
          "kind": "string",
          "optional": true
        },
        {
          "path": "build.matrix.*.probes.*.code",
          "kind": "number",
          "optional": true
        },
        {
          "path": "build.matrix.*.reuse_identity",
          "kind": "string",
          "enum": [
            "exact_commit",
            "source_tree"
          ],
          "optional": true
        },
        {
          "path": "build.matrix.*.reproducible",
          "kind": "boolean",
          "optional": true
        }
      ]
    },
    "cases": {
      "configuration": [
        {
          "name": "default configuration",
          "patch": {},
          "valid": true
        },
        {
          "name": "self-hosted runner",
          "patch": {
            "build.runner": "self-hosted"
          },
          "valid": false
        },
        {
          "name": "Git metadata publication",
          "patch": {
            "repository.include": [
              ".git"
            ]
          },
          "valid": false
        },
        {
          "name": "build output publication",
          "patch": {
            "repository.include": [
              "build"
            ]
          },
          "valid": false
        },
        {
          "name": "package outside build",
          "patch": {
            "build.package_paths": [
              "src"
            ]
          },
          "valid": false
        },
        {
          "name": "empty image list",
          "patch": {
            "images.enabled": true,
            "images.names": []
          },
          "valid": false
        },
        {
          "name": "unversioned Rust",
          "patch": {
            "build.toolchains": [
              "rust"
            ],
            "build.rust_version": ""
          },
          "valid": false
        },
        {
          "name": "unversioned CMake",
          "patch": {
            "build.toolchains": [
              "cmake"
            ],
            "build.cmake_version": "latest"
          },
          "valid": false
        },
        {
          "name": "command string",
          "patch": {
            "build.commands": [
              "cargo test"
            ]
          },
          "valid": false
        },
        {
          "name": "empty executable",
          "patch": {
            "build.commands": [
              [
                ""
              ]
            ]
          },
          "valid": false
        },
        {
          "name": "commands dictionary",
          "patch": {
            "build.commands": {
              "named": [
                "cargo",
                "test"
              ]
            }
          },
          "valid": false
        },
        {
          "name": "recursive package destination",
          "patch": {
            "build.package_paths": [
              "build/artifacts"
            ]
          },
          "valid": false
        },
        {
          "name": "build root package",
          "patch": {
            "build.package_paths": [
              "build/"
            ]
          },
          "valid": false
        },
        {
          "name": "reserved metadata",
          "patch": {
            "build.package_paths": [
              "build/manifest.json"
            ]
          },
          "valid": false
        },
        {
          "name": "duplicate image",
          "patch": {
            "images.names": [
              "smoke",
              "smoke"
            ]
          },
          "valid": false
        },
        {
          "name": "platform matrix",
          "patch": {
            "build.matrix": [
              {
                "name": "linux",
                "runner": "ubuntu-latest"
              },
              {
                "name": "windows",
                "runner": "windows-latest"
              },
              {
                "name": "macos",
                "runner": "macos-latest"
              }
            ]
          },
          "valid": true
        },
        {
          "name": "duplicate matrix name",
          "patch": {
            "build.matrix": [
              {
                "name": "linux",
                "runner": "ubuntu-latest"
              },
              {
                "name": "linux",
                "runner": "ubuntu-latest"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "matrix self-hosted runner",
          "patch": {
            "build.matrix": [
              {
                "name": "unsafe",
                "runner": "self-hosted"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "matrix path traversal name",
          "patch": {
            "build.matrix": [
              {
                "name": "../unsafe",
                "runner": "ubuntu-latest"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "omitted optional build fields",
          "remove": [
            "build.runner",
            "build.matrix",
            "build.targets",
            "build.toolchains",
            "build.rust_version",
            "build.cmake_version",
            "build.commands",
            "build.package_paths"
          ],
          "valid": true
        },
        {
          "name": "omitted optional page title",
          "remove": [
            "pages.title"
          ],
          "valid": true
        },
        {
          "name": "omitted Rust version when enabled",
          "patch": {
            "build.toolchains": [
              "rust"
            ]
          },
          "remove": [
            "build.rust_version"
          ],
          "valid": false
        },
        {
          "name": "omitted CMake version when enabled",
          "patch": {
            "build.toolchains": [
              "cmake"
            ]
          },
          "remove": [
            "build.cmake_version"
          ],
          "valid": false
        },
        {
