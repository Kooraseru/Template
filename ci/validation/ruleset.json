  "gate": {
    "rules": {
      "rules": [
        {
          "path": "enabled.repository",
          "enum": [
            "true",
            "false"
          ]
        },
        {
          "path": "enabled.pages",
          "enum": [
            "true",
            "false"
          ]
        },
        {
          "path": "enabled.release",
          "enum": [
            "true",
            "false"
          ]
        },
        {
          "path": "enabled.images",
          "enum": [
            "true",
            "false"
          ]
        },
        {
          "path": "results.validate.result",
          "equals": "success"
        },
        {
          "path": "results.build.result",
          "equals": "success"
        },
        {
          "path": "results.repository.result",
          "equals": "success",
          "when": {
            "path": "enabled.repository",
            "equals": "true"
          }
        },
        {
          "path": "results.repository.result",
          "equals": "skipped",
          "when": {
            "path": "enabled.repository",
            "equals": "false"
          }
        },
        {
          "path": "results.pages.result",
          "equals": "success",
          "when": {
            "path": "enabled.pages",
            "equals": "true"
          }
        },
        {
          "path": "results.pages.result",
          "equals": "skipped",
          "when": {
            "path": "enabled.pages",
            "equals": "false"
          }
        },
        {
          "path": "results.release.result",
          "equals": "success",
          "when": {
            "path": "enabled.release",
            "equals": "true"
          }
        },
        {
          "path": "results.release.result",
          "equals": "skipped",
          "when": {
            "path": "enabled.release",
            "equals": "false"
          }
        },
        {
          "path": "results.images.result",
          "equals": "success",
          "when": {
            "path": "enabled.images",
            "equals": "true"
          }
        },
        {
          "path": "results.images.result",
          "equals": "skipped",
          "when": {
            "path": "enabled.images",
            "equals": "false"
          }
        }
      ]
    },
    "cases": {
      "baseline": {
        "results": {
          "validate": {
            "result": "success"
          },
          "build": {
            "result": "success"
          },
          "repository": {
            "result": "skipped"
          },
          "pages": {
            "result": "skipped"
          },
          "release": {
            "result": "skipped"
          },
          "images": {
            "result": "skipped"
          }
        },
        "enabled": {
          "repository": "false",
          "pages": "false",
          "release": "false",
          "images": "false"
        }
      },
      "cases": [
        {
          "name": "disabled outputs",
          "patch": {},
          "valid": true
        },
        {
          "name": "build failure",
          "patch": {
            "results.build.result": "failure"
          },
          "valid": false
        },
        {
          "name": "validation failure",
          "patch": {
            "results.validate.result": "failure"
          },
          "valid": false
        },
        {
          "name": "enabled Pages skipped",
          "patch": {
            "enabled.pages": "true"
          },
          "valid": false
        },
        {
          "name": "enabled Pages success",
          "patch": {
            "enabled.pages": "true",
            "results.pages.result": "success"
          },
          "valid": true
        },
        {
          "name": "missing eligibility",
          "remove": [
            "enabled"
          ],
          "patch": {},
          "valid": false
        }
      ]
    }
  },
  "workflows": {
    "rules": {
      "rules": [
        {
          "path": "permissions.contents",
          "equals": "read"
        },
        {
          "path": "on.pull_request_target",
          "exists": true
        },
        {
          "path": "on.push",
          "exists": true
        },
        {
          "path": "on.workflow_dispatch",
          "exists": true
        },
        {
          "path": "on.pull_request",
          "absent": true
        },
        {
          "path": "on.workflow_run",
          "absent": true
        },
        {
          "path": "jobs.validation-receipt.if",
          "required_substrings": [
            "github.event_name == 'workflow_dispatch'",
            "refs/heads/source",
            "local_execution == 'false'"
          ]
        },
        {
          "path": "jobs.build.permissions.checks",
          "absent": true
        },
        {
          "path": "jobs.build.permissions.contents",
          "optional": true,
          "not_values": [
            "write"
          ]
        },
        {
          "path": "on.workflow_dispatch.inputs.claim",
          "absent": true
        },
        {
          "path": "on.workflow_dispatch.inputs.pr",
          "absent": true
        },
        {
          "path": "on.workflow_dispatch.inputs.target",
          "absent": true
        },
        {
          "path": "jobs.refresh-prs.name",
          "equals": "Maintenance / Pull request choices"
        },
        {
          "path": "on.workflow_dispatch.inputs",
          "key_count": 14,
          "message": "CI panel requires fourteen inputs"
        },
        {
          "path": "on.workflow_dispatch.inputs",
          "count_where": {
            "field": "type",
            "equals": "choice",
            "count": 12
          },
          "message": "CI panel requires twelve dropdowns"
        },
        {
          "path": "jobs.gate.name",
          "absent": true,
          "message": "Keep the required gate check name stable"
        },
        {
          "path": "jobs.*.steps",
          "requires_before": {
            "field": "uses",
            "value": "./.github/actions/setup-node",
            "prerequisite": "./.github/actions/setup-lune"
          }
        }
      ],
      "collections": [
        {
          "path": "jobs",
          "exclude_key_pattern": "^publish%-",
          "rules": [
            {
              "path": "permissions.*",
              "optional": true,
              "not_values": [
                "write"
              ]
            }
          ],
          "exclude_keys": [
            "gate",
            "validation-receipt",
            "validate",
            "refresh-prs"
          ]
        },
        {
          "path": "jobs",
          "key_pattern": "^publish%-",
          "rules": [
            {
              "path": "if",
              "kind": "string",
              "required_substrings": [
                "github.event_name == 'push'",
                "refs/heads/source"
              ]
            },
            {
              "path": "needs",
              "kind": "array",
              "contains": "gate"
            }
          ]
        },
        {
          "path": "jobs",
          "rules": [
            {
              "path": "steps.*.uses",
              "optional": true,
              "skip_pattern": "^%./",
              "kind": "string",
              "pattern": "@[%w%.%-]+$",
              "reject_patterns": [
                "@[a-f0-9]+$"
              ]
            }
          ]
        }
      ],
      "actions": {
        "rules": [
          {
            "path": "runs.steps.*.uses",
            "optional": true,
            "skip_pattern": "^%./",
            "kind": "string",
            "pattern": "@[%w%.%-]+$",
            "reject_patterns": [
              "@[a-f0-9]+$"
            ]
          }
        ]
      },
      "controls": {
        "source": "ci/control/options.json",
        "path": "on.workflow_dispatch.inputs",
        "default_type": "choice"
      }
    }
  },
  "rules": {
    "format": {
      "fields": {
        "path": "string",
        "kind": "string",
        "message": "string",
        "equals": "any",
        "equals_path": "string",
        "enum": "table",
        "not_values": "table",
        "min_length": "number",
        "exact_length": "number",
        "min_items": "number",
        "pattern": "string",
        "prefix": "string",
        "contains": "any",
        "required_substrings": "table",
        "capture_pattern": "string",
        "capture_length": "number",
        "reject_patterns": "table",
        "reject_substrings": "table",
        "forbidden_components": "table",
        "unique": "boolean",
        "unique_by": "string",
        "exists": "boolean",
        "absent": "boolean",
        "optional": "boolean",
        "skip_pattern": "string",
        "when": "table",
        "use": "string",
        "default": "any",
        "key_count": "number",
        "count_where": "table",
        "requires_before": "table"
      }
    },
    "cases": {
      "root": "build/tests/rules",
      "cases": [
        {
          "name": "string pattern",
          "input": "abc",
          "document": {
            "rules": [
              {
                "path": "$",
                "kind": "string",
                "pattern": "^%a+$"
              }
            ]
          },
          "valid": true
        },
        {
          "name": "pattern mismatch",
          "input": "123",
          "document": {
            "rules": [
              {
                "path": "$",
                "kind": "string",
                "pattern": "^%a+$"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "misspelled option",
          "input": "abc",
          "document": {
            "rules": [
              {
                "path": "$",
                "kind": "string",
                "patern": "^%a+$"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "wrong option type",
          "input": "abc",
          "document": {
            "rules": [
              {
                "path": "$",
                "kind": "string",
                "min_length": "1"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "conditional false",
          "input": {
            "enabled": false,
            "value": ""
          },
          "document": {
            "rules": [
              {
                "path": "value",
                "min_length": 1,
                "when": {
                  "path": "enabled",
                  "equals": true
                }
              }
            ]
          },
          "valid": true
        },
        {
          "name": "conditional true",
          "input": {
            "enabled": true,
            "value": ""
          },
          "document": {
            "rules": [
              {
                "path": "value",
                "min_length": 1,
                "when": {
                  "path": "enabled",
                  "equals": true
                }
              }
            ]
          },
          "valid": false
        },
        {
          "name": "missing required field",
          "input": {},
          "document": {
            "rules": [
              {
                "path": "required",
                "exists": true
              }
            ]
          },
          "valid": false
        },
        {
          "name": "required false value",
          "input": {
            "required": false
          },
          "document": {
            "rules": [
              {
                "path": "required",
                "exists": true
              }
            ]
          },
          "valid": true
        },
        {
          "name": "wildcard rejection",
          "input": [
            "a",
            1
          ],
          "document": {
            "rules": [
              {
                "path": "*",
                "kind": "string"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "duplicate key",
          "input": [
            {
              "name": "a"
            },
            {
              "name": "a"
            }
          ],
          "document": {
            "rules": [
              {
                "path": "$",
                "kind": "array",
                "unique_by": "name"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "object entry count",
          "input": {
            "one": 1,
            "two": 2
          },
          "document": {
            "rules": [
              {
                "path": "$",
                "key_count": 2
              }
            ]
          },
          "valid": true
        },
        {
          "name": "wrong object entry count",
          "input": {
            "one": 1
          },
          "document": {
            "rules": [
              {
                "path": "$",
                "key_count": 2
              }
            ]
          },
          "valid": false
        },
        {
          "name": "filtered entry count",
          "input": {
            "one": {
              "type": "choice"
            },
            "two": {
              "type": "string"
            }
          },
          "document": {
            "rules": [
              {
                "path": "$",
                "count_where": {
                  "field": "type",
                  "equals": "choice",
                  "count": 1
                }
              }
            ]
          },
          "valid": true
        },
        {
          "name": "wrong filtered entry count",
          "input": {
            "one": {
              "type": "string"
            }
          },
          "document": {
            "rules": [
              {
                "path": "$",
                "count_where": {
                  "field": "type",
                  "equals": "choice",
                  "count": 1
                }
              }
            ]
          },
          "valid": false
        },
        {
          "name": "prerequisite comes first",
          "input": [
            {
              "uses": "prerequisite"
            },
            {
              "uses": "consumer"
            }
          ],
          "document": {
            "rules": [
              {
                "path": "$",
                "requires_before": {
                  "field": "uses",
                  "value": "consumer",
                  "prerequisite": "prerequisite"
                }
              }
            ]
          },
          "valid": true
        },
        {
          "name": "prerequisite comes too late",
          "input": [
            {
              "uses": "consumer"
            },
            {
              "uses": "prerequisite"
            }
          ],
          "document": {
            "rules": [
              {
                "path": "$",
                "requires_before": {
                  "field": "uses",
                  "value": "consumer",
                  "prerequisite": "prerequisite"
                }
              }
            ]
          },
          "valid": false
        },
        {
          "name": "unused prerequisite is optional",
          "input": [],
          "document": {
            "rules": [
              {
                "path": "$",
                "requires_before": {
                  "field": "uses",
                  "value": "consumer",
                  "prerequisite": "prerequisite"
                }
              }
            ]
          },
          "valid": true
        },
        {
          "name": "skip patterns cannot bypass input types",
          "input": 42,
          "document": {
            "rules": [
              {
                "path": "$",
                "skip_pattern": "^%./",
                "kind": "string",
                "pattern": "@tag$"
              }
            ]
          },
          "valid": false
        },
        {
          "name": "malformed prerequisite definition",
          "input": [],
          "document": {
            "rules": [
              {
                "path": "$",
                "requires_before": {
                  "field": "uses",
                  "value": false,
                  "prerequisite": "setup"
                }
              }
            ]
          },
          "valid": false
        },
        {
          "name": "malformed count filter",
          "input": [],
          "document": {
            "rules": [
              {
                "path": "$",
                "count_where": {
                  "field": false,
                  "count": 1
                }
              }
            ]
          },
          "valid": false
        }
      ]
    }
