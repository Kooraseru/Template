{
  "root": "build/tests/rules",
  "cases": [
    {
      "name": "string pattern",
      "input": "abc",
      "document": {
        "rules": [
          {
            "path": "$",
            "kind": "string",
            "pattern": "^%a+$"
          }
        ]
      },
      "valid": true
    },
    {
      "name": "pattern mismatch",
      "input": "123",
      "document": {
        "rules": [
          {
            "path": "$",
            "kind": "string",
            "pattern": "^%a+$"
          }
        ]
      },
      "valid": false
    },
    {
      "name": "misspelled option",
      "input": "abc",
      "document": {
        "rules": [
          {
            "path": "$",
            "kind": "string",
            "patern": "^%a+$"
          }
        ]
      },
      "valid": false
    },
    {
      "name": "wrong option type",
      "input": "abc",
      "document": {
        "rules": [
          {
            "path": "$",
            "kind": "string",
            "min_length": "1"
          }
        ]
      },
      "valid": false
    },
    {
      "name": "conditional false",
      "input": {
        "enabled": false,
        "value": ""
      },
      "document": {
        "rules": [
          {
            "path": "value",
            "min_length": 1,
            "when": {
              "path": "enabled",
              "equals": true
            }
          }
        ]
      },
      "valid": true
    },
    {
      "name": "conditional true",
      "input": {
        "enabled": true,
        "value": ""
      },
      "document": {
        "rules": [
          {
            "path": "value",
            "min_length": 1,
            "when": {
              "path": "enabled",
              "equals": true
            }
          }
        ]
      },
      "valid": false
    },
    {
      "name": "missing required field",
      "input": {},
      "document": {
        "rules": [
          {
            "path": "required",
            "exists": true
          }
        ]
      },
      "valid": false
    },
    {
      "name": "required false value",
      "input": {
        "required": false
      },
      "document": {
        "rules": [
          {
            "path": "required",
            "exists": true
          }
        ]
      },
      "valid": true
    },
    {
      "name": "wildcard rejection",
      "input": [
        "a",
        1
      ],
      "document": {
        "rules": [
          {
            "path": "*",
            "kind": "string"
          }
        ]
      },
      "valid": false
    },
    {
      "name": "duplicate key",
      "input": [
        {
          "name": "a"
        },
        {
          "name": "a"
        }
      ],
      "document": {
        "rules": [
          {
            "path": "$",
            "kind": "array",
            "unique_by": "name"
          }
        ]
      },
      "valid": false
    }
  ]
}
