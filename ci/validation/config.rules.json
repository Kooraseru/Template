{
  "description": "Template-owned validation rules. Patterns use Luau string patterns, not regular expressions.",
  "definitions": {
    "relative": {
      "kind": "string",
      "min_length": 1,
      "reject_substrings": [
        "\\",
        ":",
        "//"
      ],
      "reject_patterns": [
        "^/",
        "/$",
        "[%c]"
      ],
      "forbidden_components": [
        ".",
        ".."
      ]
    }
  },
  "rules": [
    {
      "path": "$",
      "kind": "object"
    },
    {
      "path": "repository",
      "kind": "object"
    },
    {
      "path": "repository.enabled",
      "kind": "boolean"
    },
    {
      "path": "repository.publish",
      "kind": "boolean"
    },
    {
      "path": "repository.enabled",
      "equals": true,
      "when": {
        "path": "repository.publish",
        "equals": true
      },
      "message": "repository cannot publish while disabled"
    },
    {
      "path": "pages",
      "kind": "object"
    },
    {
      "path": "pages.enabled",
      "kind": "boolean"
    },
    {
      "path": "pages.publish",
      "kind": "boolean"
    },
    {
      "path": "pages.enabled",
      "equals": true,
      "when": {
        "path": "pages.publish",
        "equals": true
      },
      "message": "pages cannot publish while disabled"
    },
    {
      "path": "release",
      "kind": "object"
    },
    {
      "path": "release.enabled",
      "kind": "boolean"
    },
    {
      "path": "release.publish",
      "kind": "boolean"
    },
    {
      "path": "release.enabled",
      "equals": true,
      "when": {
        "path": "release.publish",
        "equals": true
      },
      "message": "release cannot publish while disabled"
    },
    {
      "path": "images",
      "kind": "object"
    },
    {
      "path": "images.enabled",
      "kind": "boolean"
    },
    {
      "path": "images.publish",
      "kind": "boolean",
      "default": false,
      "equals": false,
      "message": "CI images are workflow artifacts; registry publication is retired"
    },
    {
      "path": "images.enabled",
      "equals": true,
      "when": {
        "path": "images.publish",
        "equals": true
      },
      "message": "images cannot publish while disabled"
    },
    {
      "path": "repository.include",
      "kind": "array"
    },
    {
      "path": "repository.include.*",
      "use": "relative",
      "not_values": [
        "build",
        ".git"
      ],
      "reject_patterns": [
        "^build/",
        "^%.git/"
      ]
    },
    {
      "path": "pages.title",
      "kind": "string",
      "default": "Project documentation"
    },
    {
      "path": "images.names",
      "kind": "array",
      "unique": true,
      "default": []
    },
    {
      "path": "images.names.*",
      "kind": "string",
      "pattern": "^[a-z][a-z0-9%-]*$"
    },
    {
      "path": "images.names",
      "min_items": 1,
      "when": {
        "path": "images.enabled",
        "equals": true
      }
    },
    {
      "path": "build",
      "kind": "object"
    },
    {
      "path": "build.runner",
      "kind": "string",
      "enum": [
        "ubuntu-latest",
        "windows-latest",
        "macos-latest",
        "ubuntu-24.04",
        "ubuntu-24.04-arm",
        "windows-2025",
        "windows-11-arm",
        "macos-15",
        "macos-15-intel"
      ],
      "default": "ubuntu-latest"
    },
    {
      "path": "build.rust_version",
      "kind": "string",
      "default": ""
    },
    {
      "path": "build.cmake_version",
      "kind": "string",
      "default": ""
    },
    {
      "path": "build.toolchains",
      "kind": "array",
      "default": []
    },
    {
      "path": "build.toolchains.*",
      "kind": "string",
      "enum": [
        "rust",
        "cmake"
      ]
    },
    {
      "path": "build.rust_version",
      "pattern": "^%d+%.%d+%.%d+$",
      "when": {
        "path": "build.toolchains",
        "contains": "rust"
      }
    },
    {
      "path": "build.cmake_version",
      "pattern": "^%d+%.%d+%.%d+$",
      "when": {
        "path": "build.toolchains",
        "contains": "cmake"
      }
    },
    {
      "path": "build.commands",
      "kind": "array",
      "default": []
    },
    {
      "path": "build.commands.*",
      "kind": "array",
      "min_items": 1
    },
    {
      "path": "build.commands.*.*",
      "kind": "string"
    },
    {
      "path": "build.commands.*.1",
      "kind": "string",
      "min_length": 1
    },
    {
      "path": "build.package_paths",
      "kind": "array",
      "default": []
    },
    {
      "path": "build.package_paths.*",
      "use": "relative",
      "prefix": "build/",
      "not_values": [
        "build/artifacts",
        "build/manifest.json",
        "build/distribution.tar.gz",
        "build/provenance.json"
      ],
      "reject_patterns": [
        "^build/artifacts/"
      ]
    },
    {
      "path": "build.matrix",
      "kind": "array",
      "unique_by": "name",
      "default": []
    },
    {
      "path": "build.matrix.*",
      "kind": "object"
    },
    {
      "path": "build.matrix.*.name",
      "kind": "string",
      "pattern": "^[a-z][a-z0-9%-]*$"
    },
    {
      "path": "build.matrix.*.runner",
      "kind": "string",
      "enum": [
        "ubuntu-latest",
        "windows-latest",
        "macos-latest",
        "ubuntu-24.04",
        "ubuntu-24.04-arm",
        "windows-2025",
        "windows-11-arm",
        "macos-15",
        "macos-15-intel"
      ]
    },
    {
      "path": "build.targets",
      "kind": "array",
      "unique": true,
      "default": []
    },
    {
      "path": "build.targets.*",
      "kind": "string",
      "pattern": "^[a-z][a-z0-9%-]*$"
    },
    {
      "path": "build.matrix.*.image",
      "kind": "string",
      "optional": true
    },
    {
      "path": "build.matrix.*.platform",
      "kind": "string",
      "optional": true
    },
    {
      "path": "build.matrix.*.profile",
      "kind": "string",
      "optional": true
    },
    {
      "path": "build.matrix.*.target",
      "kind": "string",
      "optional": true
    },
    {
      "path": "build.matrix.*.rust_version",
      "kind": "string",
      "optional": true
    },
    {
      "path": "build.matrix.*.msvc_arch",
      "kind": "string",
      "optional": true
    },
    {
      "path": "build.matrix.*.environment",
      "kind": "object",
      "optional": true
    },
    {
      "path": "build.matrix.*.probes",
      "kind": "array",
      "optional": true
    },
    {
      "path": "build.matrix.*.environment.*",
      "kind": "string",
      "optional": true
    },
    {
      "path": "build.matrix.*.probes.*.argv",
      "kind": "array",
      "min_items": 1,
      "optional": true
    },
    {
      "path": "build.matrix.*.probes.*.argv.*",
      "kind": "string",
      "optional": true
    },
    {
      "path": "build.matrix.*.probes.*.code",
      "kind": "number",
      "optional": true
    }
  ]
}
