{
  "rules": {
    "sha_pattern": "^[a-f0-9]{40}$",
    "bot_patterns": [
      "\\[bot\\]",
      "^dependabot$",
      "^renovate$"
    ],
    "graph_rows_per_page": 100,
    "graph_colors": [
      "#58a6ff",
      "#bc8cff",
      "#3fb950",
      "#ffa657",
      "#ff7b72"
    ],
    "body_commit_limit": 80,
    "cache_run_limit": 30,
    "retry_attempts": 3,
    "asset_content_types": {
      ".png": "image/png",
      ".html": "text/html",
      ".json": "application/json",
      ".md": "text/markdown",
      ".gz": "application/gzip"
    }
  },
  "cases": {
    "history": {
      "commits": [
        {
          "id": "root",
          "branch": "source",
          "name": "Root Author",
          "email": "root@example.test",
          "message": "Initial source",
          "files": {
            "target/tracked-source.txt": "This is tracked source, not a Cargo output directory."
          }
        },
        {
          "id": "feature",
          "branch": "feature",
          "parent": "root",
          "name": "Alias",
          "email": "alias@example.test",
          "message": "Feature <safe> & unicode \u00e4\u00b8\u2013\u00e7\u2022\u0152\n\nCo-authored-by: Partner <partner@example.test>\nCo-authored-by: automation[bot] <bot@example.test>\nCo-authored-by: dependabot <dependabot@example.test>\nCo-authored-by: renovate <renovate@example.test>"
        },
        {
          "id": "main",
          "branch": "source",
          "parent": "root",
          "name": "Root Author",
          "email": "root@example.test",
          "message": "Main change"
        },
        {
          "id": "merge",
          "branch": "source",
          "merge": "feature",
          "name": "Root Author",
          "email": "root@example.test",
          "message": "Merge feature",
          "mailmap": "Canonical Author <canonical@example.test> Alias <alias@example.test>\n"
        }
      ],
      "contributors": [
        "Canonical Author",
        "Partner",
        "Root Author"
      ],
      "range_count": 3,
      "beginning_count": 4
    },
    "cache": [
      {
        "name": "trusted completed source",
        "patch": {},
        "valid": true
      },
      {
        "name": "pull request is untrusted",
        "patch": {
          "event": "pull_request"
        },
        "valid": false
      },
      {
        "name": "wrong commit",
        "patch": {
          "head_sha": "wrong"
        },
        "valid": false
      },
      {
        "name": "failed workflow",
        "patch": {
          "conclusion": "failure"
        },
        "valid": false
      },
      {
        "name": "foreign repository",
        "patch": {
          "head_repository": {
            "full_name": "someone/fork"
          }
        },
        "valid": false
      }
    ],
    "provenance": [
      {
        "name": "matching provenance",
        "patch": {},
        "valid": true
      },
      {
        "name": "wrong source",
        "patch": {
          "source_sha": "wrong"
        },
        "valid": false
      },
      {
        "name": "changed build inputs",
        "patch": {
          "fingerprint": "wrong"
        },
        "valid": false
      },
      {
        "name": "wrong target",
        "patch": {
          "target": "other"
        },
        "valid": false
      },
      {
        "name": "corrupted payload",
        "patch": {},
        "corrupt": true,
        "valid": false
      },
      {
        "name": "unlisted payload",
        "patch": {},
        "extra": true,
        "valid": false
      }
    ],
    "artifacts": [
      {
        "name": "available matching artifact",
        "input": {
          "name": "distribution-selected-linux",
          "expired": false
        },
        "valid": true
      },
      {
        "name": "expired artifact rebuilds",
        "input": {
          "name": "distribution-selected-linux",
          "expired": true
        },
        "valid": false
      },
      {
        "name": "missing selected artifact rebuilds",
        "input": {
          "name": "distribution-other-linux",
          "expired": false
        },
        "valid": false
      }
    ],
    "snapshots": [
      {
        "name": "older build checkout has its own selected Git HEAD",
        "commit": "$root",
        "present": [
          "root.txt",
          "target/tracked-source.txt"
        ],
        "absent": [
          "feature.txt",
          "merge.txt"
        ]
      },
      {
        "name": "current build checkout preserves tracked target directories",
        "commit": "$merge",
        "present": [
          "root.txt",
          "feature.txt",
          "merge.txt",
          "target/tracked-source.txt"
        ],
        "absent": []
      }
    ],
    "protection_visibility": [
      {
        "name": "verified snapshot restores hidden bypass actors",
        "valid": true
      },
      {
        "name": "hidden bypass actors without snapshot fail closed",
        "missing": true,
        "valid": false
      },
      {
        "name": "ruleset update invalidates snapshot",
        "changed_time": true,
        "valid": false
      },
      {
        "name": "changed visible rules invalidate snapshot",
        "changed_rules": true,
        "valid": false
      },
      {
        "name": "snapshot from another repository rejected",
        "wrong_repository": true,
        "valid": false
      },
      {
        "name": "unsafe bypass snapshot rejected",
        "unsafe": true,
        "valid": false
      }
    ],
    "png_base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+j4iMAAAAASUVORK5CYII=",
    "releases": [
      {
        "name": "explicit Release commit",
        "input": {
          "releases": [
            {
              "version": "1.2.0",
              "commit": "$merge",
              "from": "$root"
            }
          ]
        },
        "valid": true
      },
      {
        "name": "explicit Pre-Release commit",
        "input": {
          "releases": [
            {
              "version": "1.3.0-pre.1",
              "commit": "$merge"
            }
          ]
        },
        "valid": true
      },
      {
        "name": "empty notes range",
        "input": {
          "releases": [
            {
              "version": "1.0.0",
              "commit": "$root",
              "from": "$root"
            }
          ]
        },
        "valid": true
      },
      {
        "name": "floating source selection is rejected",
        "input": {
          "releases": [
            {
              "version": "1.0.0",
              "commit": "latest"
            }
          ]
        },
        "valid": false
      },
      {
        "name": "short SHA",
        "input": {
          "releases": [
            {
              "version": "1.0.0",
              "commit": "abcd123"
            }
          ]
        },
        "valid": false
      },
      {
        "name": "backwards range",
        "input": {
          "releases": [
            {
              "version": "1.0.0",
              "commit": "$root",
              "from": "$merge"
            }
          ]
        },
        "valid": false
      },
      {
        "name": "sideways range",
        "input": {
          "releases": [
            {
              "version": "1.0.0",
              "commit": "$main",
              "from": "$feature"
            }
          ]
        },
        "valid": false
      },
      {
        "name": "unknown selection option",
        "input": {
          "releases": [
            {
              "version": "1.0.0",
              "commit": "$merge",
              "alias": "moving"
            }
          ]
        },
        "valid": false
      },
      {
        "name": "unsafe notes path",
        "input": {
          "releases": [
            {
              "version": "1.0.0",
              "commit": "$merge",
              "notes": "../private"
            }
          ]
        },
        "valid": false
      },
      {
        "name": "duplicate public version",
        "input": {
          "releases": [
            {
              "version": "1.0.0",
              "commit": "$root"
            },
            {
              "version": "1.0.0",
              "commit": "$merge"
            }
          ]
        },
        "valid": false
      },
      {
        "name": "alternate prerelease identity rejected",
        "input": {
          "releases": [
            {
              "version": "1.0.0-beta.1",
              "commit": "$merge"
            }
          ]
        },
        "valid": false
      }
    ],
    "planning": [
      {
        "name": "source-only plan preserves missing fields and empty matrices",
        "build": {
          "commands": {},
          "package_paths": {}
        },
        "target": {
          "name": "default",
          "runner": "ubuntu-latest",
          "environment": {
            "special": "quote\" slash\\ newline\n emoji \ud83d\ude00"
          },
          "probes": {}
        }
      },
      {
        "name": "image identities deduplicate and keep numeric recipe inputs",
        "build": {
          "commands": [
            [
              "compiler",
              "--version"
            ]
          ],
          "package_paths": [
            "build/program"
          ],
          "numeric": [
            1e-07,
            1e+20,
            0.1
          ]
        },
        "target": {
          "name": "linux-x64",
          "runner": "ubuntu-latest",
          "target": "x86_64-linux-gnu",
          "profile": "gcc",
          "reuse_identity": "source_tree",
          "reproducible": false,
          "image_definition": {
            "name": "ubuntu-gcc",
            "platform": "linux/amd64",
            "version": "1"
          },
          "recipes": {
            "Dockerfile": "FROM example\n",
            "install.sh": "echo \"hello\"\n"
          }
        },
        "duplicate_images": true
      }
    ]
  },
  "protection": {
    "source_checks": {
      "name": "Source requires pull requests and CI",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/source"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "pull_request",
          "parameters": {
            "dismiss_stale_reviews_on_push": true,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_approving_review_count": 0,
            "required_review_thread_resolution": true
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              {
                "context": "gate",
                "integration_id": 15368
              }
            ]
          }
        }
      ]
    },
    "source_admins": {
      "name": "Only administrators merge source",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [
        {
          "actor_id": 5,
          "actor_type": "RepositoryRole",
          "bypass_mode": "pull_request"
        }
      ],
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/source"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "update",
          "parameters": {
            "update_allows_fetch_and_merge": false
          }
        }
      ]
    }
  }
}
