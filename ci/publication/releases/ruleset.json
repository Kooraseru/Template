{
  "rules": {
    "sha_pattern": "^[a-f0-9]{40}$",
    "bot_patterns": [
      "\\[bot\\]",
      "^dependabot$",
      "^renovate$"
    ],
    "graph_rows_per_page": 100,
    "graph_colors": [
      "#58a6ff",
      "#bc8cff",
      "#3fb950",
      "#ffa657",
      "#ff7b72"
    ],
    "body_commit_limit": 80,
    "cache_run_limit": 30,
    "retry_attempts": 3,
    "asset_content_types": {
      ".png": "image/png",
      ".html": "text/html",
      ".json": "application/json",
      ".md": "text/markdown",
      ".gz": "application/gzip"
    }
  }
}
