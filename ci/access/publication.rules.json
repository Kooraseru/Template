{
  "rules": [
    {
      "path": "$",
      "kind": "object"
    },
    {
      "path": "localRun",
      "equals": false
    },
    {
      "path": "actions",
      "equals": "true"
    },
    {
      "path": "server",
      "equals": "https://github.com"
    },
    {
      "path": "event",
      "enum": [
        "push",
        "workflow_dispatch"
      ]
    },
    {
      "path": "ref",
      "equals": "refs/heads/source"
    },
    {
      "path": "repository",
      "kind": "string",
      "min_length": 1
    },
    {
      "path": "eventRepository",
      "equals_path": "repository"
    },
    {
      "path": "manualAllowed",
      "equals": true,
      "when": {
        "path": "event",
        "equals": "workflow_dispatch"
      }
    }
  ]
}
