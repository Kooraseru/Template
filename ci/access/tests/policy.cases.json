{
  "baseline": {
    "localRun": false,
    "actions": "true",
    "server": "https://github.com",
    "event": "push",
    "ref": "refs/heads/source",
    "repository": "example/project",
    "eventRepository": "example/project"
  },
  "policy": [
    {
      "name": "trusted source push",
      "patch": {},
      "valid": true
    },
    {
      "name": "deny localRun",
      "patch": {
        "localRun": true
      },
      "valid": false
    },
    {
      "name": "deny actions",
      "patch": {
        "actions": "false"
      },
      "valid": false
    },
    {
      "name": "deny ref",
      "patch": {
        "ref": "refs/heads/main"
      },
      "valid": false
    },
    {
      "name": "deny repository",
      "patch": {
        "repository": ""
      },
      "valid": false
    },
    {
      "name": "deny eventRepository",
      "patch": {
        "eventRepository": "someone/fork"
      },
      "valid": false
    },
    {
      "name": "deny server",
      "patch": {
        "server": "http://localhost"
      },
      "valid": false
    },
    {
      "name": "deny pull_request",
      "patch": {
        "event": "pull_request"
      },
      "valid": false
    },
    {
      "name": "deny pull_request_target",
      "patch": {
        "event": "pull_request_target"
      },
      "valid": false
    },
    {
      "name": "deny workflow_dispatch",
      "patch": {
        "event": "workflow_dispatch"
      },
      "valid": false
    },
    {
      "name": "missing local flag",
      "remove": [
        "localRun"
      ],
      "patch": {},
      "valid": false
    },
    {
      "name": "verified manual source publication",
      "patch": {
        "event": "workflow_dispatch",
        "manualAllowed": true
      },
      "valid": true
    }
  ],
  "repositories": [
    {
      "input": {
        "repository": {
          "full_name": "example/project"
        }
      },
      "expected": "example/project"
    },
    {
      "input": {
        "repository": "invalid"
      }
    },
    {
      "input": {
        "repository": {
          "full_name": 123
        }
      }
    },
    {
      "input": false
    }
  ],
  "outputs": [
    {
      "input": {
        "runner": "ubuntu-latest\npublish=true"
      },
      "valid": false
    },
    {
      "input": {
        "enabled": "true"
      },
      "valid": true,
      "expected": "enabled=true\n"
    }
  ]
}
