-- ci/libraries/registry/agent-rules.luau
--!strict
-- Deterministic local AGENTS.md index; authoritative rules remain tracked.
local AgentRules = {}

local Fs = require("@lune/fs")

local required = {
    "rules/README.md",
    "rules/general.md",
    "rules/architecture.md",
    "rules/workflows/implementation.md",
    "rules/workflows/review.md",
    "rules/languages/luau/README.md",
    "rules/languages/luau/files/module-roots.md",
    "rules/languages/luau/language/control-flow.md",
    "rules/languages/rust/README.md",
    "rules/languages/rust/rust-system.md",
    "rules/languages/rust/files/manifests.md",
    "rules/languages/rust/files/modules.md",
    "rules/languages/rust/language/control-flow.md",
    "rules/languages/rust/language/writing.md",
    "rules/languages/rust/language/comments.md",
    "rules/languages/rust/structures/structure-system.md",
}

local function output(): string
    return table.concat({
        "# Local agent instructions",
        "",
        "<!-- Generated by ci/run.sh rules sync; do not commit or edit. -->",
        "",
        "Read `rules/general.md` and `rules/architecture.md` before editing.",
        "Consult `rules/workflows/implementation.md` when implementing changes.",
        "Consult `rules/workflows/review.md` when reviewing changes.",
        "",
        "Language-specific guidance:",
        "- Luau: `rules/languages/luau/README.md`, its control-flow rule, and module-root guidance",
        "- Rust: `rules/languages/rust/README.md`, `language/writing.md`, `language/comments.md`, and its chosen structure",
        "",
        "Read applicable tracked contracts under `rules/contracts/` when migrated.",
        "The `rules/` Markdown documents are authoritative. Do not use KERO.",
        "",
    }, "\n")
end

function AgentRules.Check()
    for _, path in required do
        assert(Fs.isFile(path), "missing required rule: " .. path)
        assert(#Fs.readFile(path) > 0, "empty rule: " .. path)
    end
    assert(Fs.isFile(".gitignore"), "missing .gitignore")
    assert(Fs.readFile(".gitignore"):find("\n/AGENTS.md\n", 1, true), "AGENTS.md must be Git-ignored")
    if Fs.isFile("AGENTS.md") then
        assert(Fs.readFile("AGENTS.md") == output(), "AGENTS.md is stale; run ci/run.sh rules sync")
    end
end

function AgentRules.Sync()
    for _, path in required do
        assert(Fs.isFile(path), "missing required rule: " .. path)
    end
    Fs.writeFile("AGENTS.md", output())
    AgentRules.Check()
end

return AgentRules
