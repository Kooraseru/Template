{
  "operation": {
    "rules": {
      "rules": [
        {
          "path": "GH_TOKEN",
          "kind": "string",
          "min_length": 1
        },
        {
          "path": "GITHUB_SHA",
          "kind": "string",
          "min_length": 1
        }
      ]
    }
  },
  "outputs": {
    "rules": {
      "rules": [
        {
          "path": "$",
          "kind": "object"
        },
        {
          "path": "*",
          "kind": "string",
          "reject_patterns": [
            "[\r\n]"
          ]
        }
      ],
      "key_pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    }
  },
  "publication": {
    "rules": {
      "rules": [
        {
          "path": "$",
          "kind": "object"
        },
        {
          "path": "localRun",
          "equals": false
        },
        {
          "path": "actions",
          "equals": "true"
        },
        {
          "path": "server",
          "equals": "https://github.com"
        },
        {
          "path": "event",
          "enum": [
            "push",
            "workflow_dispatch"
          ]
        },
        {
          "path": "ref",
          "equals": "refs/heads/source"
        },
        {
          "path": "repository",
          "kind": "string",
          "min_length": 1
        },
        {
          "path": "eventRepository",
          "equals_path": "repository"
        },
        {
          "path": "pushAllowed",
          "equals": true,
          "when": {
            "path": "event",
            "equals": "push"
          }
        },
        {
          "path": "manualAllowed",
          "equals": true,
          "when": {
            "path": "event",
            "equals": "workflow_dispatch"
          }
        }
      ]
    }
  }
}
