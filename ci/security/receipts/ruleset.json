{
  "rules": {
    "retention_days": 30,
    "staging_prefix": "ci-validation-",
    "default_reuse_identity": "exact_commit",
    "reuse_identities": [
      "exact_commit",
      "source_tree"
    ],
    "native_runners": {
      "windows": "win32",
      "macos": "darwin"
    },
    "required_receipt_fields": [
      "repository",
      "tested_sha",
      "tree",
      "source_manifest_sha256",
      "controller_hash",
      "created_at",
      "pr",
      "targets"
    ],
    "required_target_fields": [
      "name",
      "source_sha",
      "tree",
      "source_manifest_sha256",
      "fingerprint",
      "reuse_identity",
      "result",
      "execution",
      "files",
      "logs"
    ],
    "required_bundle_files": [
      "provenance.json",
      "manifest.json",
      "distribution.tar.gz"
    ],
    "receipt_asset": "receipt.json",
    "archive_asset": "bundle.tar.gz",
    "max_archive_bytes": 2000000000,
    "contract_paths": [
      "ci/security/receipts/ruleset.json",
      "ci/security/receipts/keys.json"
    ]
  }
}
