{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template dependency manifest",
  "type": "object",
  "required": [
    "providers",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "providers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "builtin": {
            "enum": [
              "local",
              "github-release",
              "npm"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "builtin"
            ]
          },
          {
            "required": [
              "command"
            ]
          }
        ]
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "options": {
            "type": "object"
          }
        }
      }
    }
  }
}
