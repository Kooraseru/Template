# Keep legacy local agent state private.
/.codex/

# CI and local build outputs.
/build/

# Installed dependencies and persistent machine-local workspace state.
/dependencies/managed/
/.workspace/

# Installed Node packages used by the dependency loader and editor tooling.
**/node_modules/

# Generated TypeScript incremental build state.
*.tsbuildinfo

# Tool discovery files generated from the canonical configs in .vscode/config/.
/.luaurc
/tsconfig.json

# Interrupted dependency layout migration copies.
/dependencies/.managed-migration-*/
