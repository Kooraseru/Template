# Ignore all local Codex state, settings, and hooks.
/.codex/

# CI and local build outputs.
/build/

# Generated dependency packages, binaries, and type definitions are under /build.

# Installed Node packages used by the dependency loader and editor tooling.
**/node_modules/

# Generated TypeScript incremental build state.
*.tsbuildinfo

# Tool discovery files generated from the canonical configs in .vscode/config/.
/.luaurc
/tsconfig.json
