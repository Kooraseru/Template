{
  "controls": {
    "operation": {
      "description": "Run / Operation",
      "default": "Validate",
      "options": [
        "Validate",
        "Build",
        "Publish",
        "Full Run"
      ]
    },
    "pull_request": {
      "description": "Run / Pull request",
      "default": "Source",
      "options": [
        "Source"
      ]
    },
    "validation_scope": {
      "description": "Validate / Scope",
      "default": "All",
      "options": [
        "All",
        "Configuration",
        "Workflow rules",
        "Access policy",
        "Receipts",
        "Release tooling"
      ]
    },
    "build_targets": {
      "description": "Build / Targets",
      "default": "Configured",
      "options": [
        "Configured",
        "All supported",
        "Linux",
        "Windows",
        "macOS"
      ]
    },
    "compiler": {
      "description": "Build / Compiler filter",
      "default": "Any",
      "options": [
        "Any",
        "GCC",
        "Clang",
        "MSVC",
        "MinGW",
        "Rust"
      ]
    },
    "architecture": {
      "description": "Build / Architecture filter",
      "default": "Any",
      "options": [
        "Any",
        "x64",
        "ARM64"
      ]
    },
    "images": {
      "description": "Build / Container images",
      "default": "Configured",
      "options": [
        "Configured",
        "Skip",
        "Required by selected builds",
        "All catalogue images"
      ]
    },
    "repository_output": {
      "description": "Outputs / Repository",
      "default": "Configured",
      "options": [
        "Configured",
        "Skip",
        "Generate only",
        "Generate and publish"
      ]
    },
    "documentation_output": {
      "description": "Outputs / Documentation",
      "default": "Configured",
      "options": [
        "Configured",
        "Skip",
        "Generate only",
        "Generate and publish"
      ]
    },
    "release_output": {
      "description": "Outputs / Releases",
      "default": "Configured",
      "options": [
        "Configured",
        "Skip",
        "Assemble only",
        "Publish Release",
        "Publish Pre-Release"
      ]
    },
    "cache_policy": {
      "description": "Policy / Cache",
      "default": "Reuse matching results",
      "options": [
        "Reuse matching results",
        "Rebuild outputs",
        "Rebuild images and outputs",
        "Require stored results"
      ]
    },
    "gate_policy": {
      "description": "Policy / Gates",
      "default": "Enforce all",
      "options": [
        "Enforce all",
        "Ignore validation failures",
        "Ignore incomplete coverage",
        "Ignore both"
      ]
    },
    "release_version": {
      "description": "Release / Version (optional override, paired with source commit)",
      "default": "",
      "type": "string"
    },
    "release_commit": {
      "description": "Release / Source commit (full SHA, paired with version)",
      "default": "",
      "type": "string"
    }
  },
