---
interface TocItem { slug: string; text: string; children: TocItem[] }
interface Props { items: TocItem[] }
const {items}=Astro.props;
---
<ul class="docs-toc-list">
  {items.map(item=><li><a href={'#'+encodeURIComponent(item.slug)}><span>{item.text}</span></a>{item.children.length>0 && <Astro.self items={item.children}/>}</li>)}
</ul>
