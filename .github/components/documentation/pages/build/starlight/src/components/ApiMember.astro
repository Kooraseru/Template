---
import ApiIcon from './ApiIcon.astro';
import ApiSignature from './ApiSignature.astro';
import type { TypeReferences } from './ApiSignature.astro';
import type { Props as IconProps } from './ApiIcon.astro';
import { formatSignature } from '../data/format-signature.mjs';
interface Entry { name: string; type: string; description: string }
interface Props {
  id: string;
  name: string;
  kind: IconProps['kind'];
  signature: string;
  description: string;
  types?: TypeReferences;
  parameters?: Entry[];
  returns?: Entry[];
  values?: { name: string; value: number; description: string }[];
  deprecation?: string;
  metadata?: { label: string; value: string }[];
}
const {
  id, name, kind, signature, description, types, parameters = [], returns = [],
  values = [], deprecation, metadata = [],
} = Astro.props;
const multiline = ['function','method','constructor','operator'].includes(kind) ? formatSignature(signature) : null;
---
<section class="api-member" data-api-member={id} data-kind={kind} data-member-name={name}>
  <span class="api-member-icon-template" hidden>{kind !== 'constructor' && <ApiIcon kind={kind}/>}</span>
  {deprecation && <span class="api-member-status">Deprecated</span>}
  <p>{description}</p>
  {(deprecation || metadata.length > 0) && (
    <details class="api-disclosure">
      <summary>{name} details</summary>
      {deprecation && <p>{deprecation}</p>}
      {metadata.length > 0 && (
        <dl class="api-member-metadata">
          {metadata.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      )}
    </details>
  )}
  <div class="api-signature-panel">{multiline ? <>
    <span class="api-signature-line"><ApiSignature signature={multiline.before} types={types} memberName/></span>
    <span class="api-signature-line api-signature-indent"><ApiSignature signature={multiline.args} types={types}/></span>
    <span class="api-signature-line"><ApiSignature signature={multiline.after} types={types}/></span>
  </> : <ApiSignature signature={signature} types={types} memberName/>}</div>
  {[
    { title: 'Parameters', values: parameters },
    { title: 'Returns', values: returns },
  ].filter(group => group.values.length).map(group => <>
    <h4>{group.title}</h4>
    <dl class="api-parameter-list">{group.values.map(item => <div><dt><ApiSignature signature={item.name ? item.name+' : '+item.type : item.type} types={types} memberName={Boolean(item.name)}/></dt><dd>{item.description}</dd></div>)}</dl>
  </>)}
  {values.length > 0 && <>
    <h4>Items</h4>
    <div class="api-enum-scroll" role="region" aria-label={name + ' items'} tabindex="0">
      <table class="api-enum-table">
        <thead><tr><th scope="col">Name</th><th scope="col">Value</th><th scope="col">Description</th></tr></thead>
        <tbody>{values.map(item => <tr><td><code>{item.name}</code></td><td>{item.value}</td><td>{item.description}</td></tr>)}</tbody>
      </table>
    </div>
  </>}
  {Astro.slots.has('samples') && <>
    <h4>Code Samples</h4>
    <slot name="samples" />
  </>}
</section>
