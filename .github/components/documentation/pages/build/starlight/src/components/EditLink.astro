---
import { Icon } from '@astrojs/starlight/components';
const { editUrl } = Astro.locals.starlightRoute;
const authoredUrl = editUrl ? new URL(editUrl) : undefined;
if (authoredUrl) authoredUrl.pathname = authoredUrl.pathname.replace('/content/docs/src/content/docs/', '/content/docs/');
---
{authoredUrl && <a class="docs-edit-link" href={authoredUrl.href}><Icon name="pencil" size="1.2em"/>{Astro.locals.t('page.editLink')}</a>}
<style>
.docs-edit-link { display:inline-flex; align-items:center; gap:8px; color:var(--docs-muted); text-decoration:none; }
.docs-edit-link:hover { color:var(--docs-heading); text-decoration:underline; }
</style>
