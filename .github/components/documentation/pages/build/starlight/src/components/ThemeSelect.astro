---
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
---

<Default><slot /></Default>
<docs-accent-picker>
  <label title="Choose an accent if your browser does not expose its theme">
    <span class="sr-only">Documentation accent color</span>
    <input type="color" name="docs-accent" value="#6e5a50" aria-label="Documentation accent color" />
  </label>
  <button type="button" title="Use browser accent" aria-label="Reset to browser accent">Auto</button>
</docs-accent-picker>

<script>
  class DocsAccentPicker extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input');
      const reset = this.querySelector('button');
      if (!input || !reset) return;
      const root = document.documentElement;
      const key = 'docs-accent';

      const refresh = () => {
        const value = root.style.getPropertyValue('--docs-user-accent');
        if (/^#[0-9a-f]{6}$/i.test(value)) input.value = value;
        else {
          // Sample only the web-exposed system color, never browser chrome.
          const probe = document.createElement('span');
          probe.style.color = 'AccentColor';
          probe.hidden = true;
          this.append(probe);
          const rgb = getComputedStyle(probe).color.match(/^rgb\((\d+),\s*(\d+),\s*(\d+)\)$/);
          probe.remove();
          if (rgb) input.value = '#' + rgb.slice(1).map(v => Number(v).toString(16).padStart(2, '0')).join('');
        }
        reset.disabled = !value;
      };

      input.addEventListener('input', () => {
        root.style.setProperty('--docs-user-accent', input.value);
        try { localStorage.setItem(key, input.value); } catch {}
        window.dispatchEvent(new Event('docs-accent-change'));
      });
      reset.addEventListener('click', () => {
        root.style.removeProperty('--docs-user-accent');
        try { localStorage.removeItem(key); } catch {}
        window.dispatchEvent(new Event('docs-accent-change'));
      });
      window.addEventListener('docs-accent-change', refresh);
      refresh();
    }
  }
  if (!customElements.get('docs-accent-picker'))
    customElements.define('docs-accent-picker', DocsAccentPicker);
</script>

<style>
  docs-accent-picker {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    font-size: var(--sl-text-xs);
  }
  input[type='color'] {
    inline-size: 1.4rem;
    block-size: 1.4rem;
    padding: 0;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .25rem;
  }
  button {
    color: var(--sl-color-text);
    background: transparent;
    border: 0;
    padding: .2rem;
    cursor: pointer;
  }
  button:disabled { opacity: .55; cursor: default; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (forced-colors: active) {
    docs-accent-picker { display: none; }
  }
</style>
