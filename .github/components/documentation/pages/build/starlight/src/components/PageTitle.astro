---
const {entry}=Astro.locals.starlightRoute;
const title=entry.data.title;
const home=import.meta.env.BASE_URL;
---
<nav class="docs-breadcrumb" aria-label="Breadcrumb">
  <a href={home}>Documentation</a>
  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="m4 2 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span aria-current="page">{title}</span>
</nav>
<h1 id="_top">{title}</h1>
<style>
.docs-breadcrumb { display:flex; align-items:center; gap:8px; font-size:14px; line-height:24px; min-height:24px; color:var(--docs-text); }
.docs-breadcrumb a { color:inherit; text-decoration:none; }
.docs-breadcrumb a:hover { color:var(--docs-heading); text-decoration:underline; }
.docs-breadcrumb span { color:var(--docs-heading); font-weight:600; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
h1#_top { margin:24px 0 0; color:var(--docs-title); }
@media (max-width:37.499rem) { h1#_top { margin-top:16px; } }
</style>
