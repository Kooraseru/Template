---
const {entry}=Astro.locals.starlightRoute;
const title=entry.data.title;
const titleParts=title.split(/(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])/);
const home=import.meta.env.BASE_URL;
---
<nav class="docs-breadcrumb" aria-label="Breadcrumb">
  <a href={home}>Documentation</a>
  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="m4 2 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span aria-current="page">{title}</span>
</nav>
<div class="titleRow">
  <div class="titleContainer">
    <span class="MuiTypography-root Typography-h1-Typography-root-title MuiTypography-inherit" id="_top" role="heading" aria-level="1">{titleParts.map((part,index)=><>{index>0&&<wbr/>}{part}</>)}</span>
  </div>
</div>
<style>
.docs-breadcrumb { display:flex; align-items:center; gap:8px; font-size:14px; line-height:24px; min-height:24px; color:var(--docs-text); }
.docs-breadcrumb a { color:inherit; text-decoration:none; }
.docs-breadcrumb a:hover { color:var(--docs-heading); text-decoration:underline; }
.docs-breadcrumb span { color:var(--docs-heading); font-weight:600; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
 .titleRow { display:flex; margin:24px 0 0; }
.titleContainer { min-width:0; }
.Typography-h1-Typography-root-title { display:block; margin:0; color:var(--docs-title); }
@media (max-width:37.499rem) { .titleRow { margin-top:16px; } }
</style>

<script>
  for (const table of document.querySelectorAll('.sl-markdown-content table:not(.api-enum-table)')) {
    if (table.parentElement?.classList.contains('docs-table-scroll')) continue;
    const wrapper = document.createElement('div');
    wrapper.className = 'docs-table-scroll';
    table.before(wrapper);
    wrapper.append(table);
  }
</script>
