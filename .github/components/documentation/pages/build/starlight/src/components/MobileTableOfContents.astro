---
import TocList from './TocList.astro';
import TocController from './TocController.astro';
import { Icon } from '@astrojs/starlight/components';
const {toc}=Astro.locals.starlightRoute;
---
{toc && <docs-mobile-toc>
  <nav aria-label={Astro.locals.t('tableOfContents.onThisPage')}>
    <details>
      <summary>
        <span class="docs-mobile-toc-label">{Astro.locals.t('tableOfContents.onThisPage')} <Icon name="right-caret" size="14px"/></span>
        <span class="docs-mobile-toc-current"></span>
      </summary>
      <div class="docs-mobile-toc-dropdown"><TocList items={toc.items}/></div>
    </details>
  </nav>
  <TocController/>
</docs-mobile-toc>}
