---
import ApiIcon from './ApiIcon.astro';
import ApiSignature from './ApiSignature.astro';
import type { Props as IconProps } from './ApiIcon.astro';
interface Member { kind: IconProps['kind']; signature: string; href: string; description?: string }
interface Props { members: Member[] }
const { members } = Astro.props;
---
<ul class="api-summary">
  {members.map(member => (
    <li data-kind={member.kind}>
      <div class="api-summary-row">
        {member.kind !== 'constructor' && <ApiIcon kind={member.kind} />}
        <a class="api-member-link" href={member.href} aria-label={'Go to '+member.signature}></a>
        <span class="api-summary-content"><ApiSignature signature={member.signature} />{member.description && <span class="api-description">{member.description}</span>}</span>
      </div>
    </li>
  ))}
</ul>
