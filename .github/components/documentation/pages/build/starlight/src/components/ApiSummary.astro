---
import ApiIcon from './ApiIcon.astro';
import ApiSignature from './ApiSignature.astro';
import type { TypeReferences } from './ApiSignature.astro';
import type { Props as IconProps } from './ApiIcon.astro';
interface Member { kind: IconProps['kind']; signature: string; href: string; description?: string }
interface Props { members: Member[]; types?: TypeReferences; descriptions?: boolean }
const { members, types, descriptions = false } = Astro.props;
---
<ul class="api-summary">
  {members.map(member => (
    <li data-kind={member.kind}>
      <div class="api-summary-row">
        {member.kind !== 'constructor' && <ApiIcon kind={member.kind} />}
        <span class="api-summary-content"><ApiSignature signature={member.signature} memberHref={member.href} types={types}/>{descriptions && member.description && <span class="api-description">{member.description}</span>}</span>
      </div>
    </li>
  ))}
</ul>
