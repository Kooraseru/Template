---
import ApiIcon from './ApiIcon.astro';
import type { Props as IconProps } from './ApiIcon.astro';
interface Member {
  kind: IconProps['kind'];
  signature: string;
  href: string;
  description?: string;
}
interface Props { members: Member[] }
const { members } = Astro.props;
---
<ul class="api-summary">
  {members.map(member => (
    <li data-kind={member.kind}>
      <a href={member.href}>
        <ApiIcon kind={member.kind} />
        <span><span class="api-signature">{member.signature}</span>{member.description && <span class="api-description">{member.description}</span>}</span>
      </a>
    </li>
  ))}
</ul>
