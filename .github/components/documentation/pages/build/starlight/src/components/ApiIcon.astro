---
export interface Props {
  kind: 'function' | 'method' | 'property' | 'signal' | 'event' | 'callback' | 'type' | 'class' | 'enum' | 'constant' | 'constructor' | 'operator';
}
const { kind } = Astro.props;
---
<svg viewBox="0 0 24 24" class="api-icon" data-kind={kind} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {['function','method','constructor'].includes(kind) ? <path fill="currentColor" stroke="none" d="m12 3 8 4.5-8 4.5-8-4.5L12 3Zm-8 6 7.25 4.1v8L4 17V9Zm8.75 4.1L20 9v8l-7.25 4.1v-8Z"/> :
    ['signal','event'].includes(kind) ? <path fill="currentColor" stroke="none" d="M13 2 4 14h7l-1 8 10-13h-8l1-7Z"/> :
    kind === 'callback' ? <path d="M4 6h9a5 5 0 0 1 0 10H7m3-4-4 4 4 4"/> :
    kind === 'property' ? <><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M8 9h8M8 13h5M8 16h3"/></> :
    kind === 'enum' ? <><path d="M9 5h11M9 12h11M9 19h11"/><circle cx="4" cy="5" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="19" r="1"/></> :
    kind === 'constant' ? <><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6M12 9v6M9 15h6"/></> :
    kind === 'operator' ? <path d="M4 8h7M7.5 4.5v7M14 16h7M14 19h7"/> :
    kind === 'class' ? <><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m12 12 8-4.5M12 12 4 7.5M12 12v9"/><path d="m8 5.25 8 4.5"/></> :
    <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 9 8-4.5M12 12 4 7.5M12 12v9"/>}
</svg>
