---
import icons from '../data/api-icons.json';
export interface Props {
  kind: 'function' | 'method' | 'property' | 'signal' | 'event' | 'callback' | 'type' | 'class' | 'enum' | 'constant' | 'constructor' | 'operator';
}
const { kind } = Astro.props;
// Match the captured Creator Hub member icon families. Library-specific
// functions, signals and constants use their corresponding engine family.
// Constructors and standalone types have no invented member glyph.
const family = ({ function: 'method', method: 'method', callback: 'method', property: 'property', constant: 'property', event: 'event', signal: 'event' } as const)[kind as 'function' | 'method' | 'callback' | 'property' | 'constant' | 'event' | 'signal'];
const icon = family ? icons[family] : undefined;
---
{icon && <svg viewBox={icon.viewBox} width={family === 'method' ? 25 : 21} height={family === 'method' ? 25 : 21} class="api-icon" data-kind={kind} data-family={family} style={'--api-icon-color:'+icon.color} aria-hidden="true" fill="currentColor">
  {icon.paths.map(d => <path d={d} fill-rule={icon.evenOdd ? 'evenodd' : 'nonzero'} clip-rule={icon.evenOdd ? 'evenodd' : 'nonzero'}/>)}
</svg>}
