<script>
  let sampleId = 0;
  for (const sample of document.querySelectorAll<HTMLElement>('.sl-markdown-content .expressive-code')) {
    const pre = sample.querySelector('pre');
    if (!pre || pre.querySelectorAll('.ec-line').length <= 19) continue;
    if (!pre.id) pre.id = 'docs-code-sample-' + ++sampleId;
    sample.setAttribute('data-collapsed', '');
    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'docs-code-toggle';
    const setToggleLabel = (expanded: boolean) => {
      const label = expanded ? 'Collapse code' : 'Expand code';
      toggle.title = label;
      toggle.setAttribute('aria-label', label);
      toggle.setAttribute('aria-expanded', String(expanded));
    };
    setToggleLabel(false);
    toggle.setAttribute('aria-controls', pre.id);
    sample.append(toggle);
    toggle.addEventListener('click', () => {
      const collapsed = sample.toggleAttribute('data-collapsed');
      setToggleLabel(!collapsed);
      if (collapsed) pre.scrollTop = 0;
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.expressive-code .copy button[data-copied]')) {
    button.dataset.copied = 'Text copied to clipboard';
  }

  // One viewport-positioned card avoids clipping inside summary rows and code signatures.
  const card = document.createElement('div');
  card.className = 'api-type-card';
  card.setAttribute('role','tooltip');
  card.id = 'api-type-card';
  card.hidden = true;
  document.body.append(card);
  let active: HTMLElement | null = null;
  let timeout: ReturnType<typeof setTimeout> | undefined;
  function hide() {
    clearTimeout(timeout);
    active?.removeAttribute('aria-describedby');
    active = null;
    card.hidden = true;
  }
  function position() {
    if (!active || card.hidden) return;
    const r = active.getBoundingClientRect();
    const w = card.offsetWidth, h = card.offsetHeight;
    card.style.left = Math.max(8,Math.min(innerWidth-w-8,r.left+r.width/2-w/2))+'px';
    const above = r.bottom+h+12 > innerHeight && r.top > h+12;
    card.style.top = Math.max(8,Math.min(innerHeight-h-8,above ? r.top-h-10 : r.bottom+10))+'px';
    card.dataset.side = above ? 'above' : 'below';
    card.style.setProperty('--arrow-x',Math.max(12,Math.min(w-12,r.left+r.width/2-parseFloat(card.style.left)))+'px');
  }
  function show(el: HTMLElement) {
    clearTimeout(timeout);
    active?.removeAttribute('aria-describedby');
    active=el;
    el.setAttribute('aria-describedby',card.id);
    const title=document.createElement('strong'); title.textContent=el.dataset.apiType||'';
    const category=document.createElement('div'); category.className='api-type-category'; category.textContent=el.dataset.category||'';
    const desc=document.createElement('div'); desc.textContent=el.dataset.description||'';
    card.replaceChildren(title,category,desc);
    card.hidden=false; position();
  }
  function delayHide(){clearTimeout(timeout);timeout=setTimeout(hide,160);}
  for(const el of document.querySelectorAll<HTMLElement>('[data-api-type]')){
    el.addEventListener('pointerenter',()=>show(el));
    el.addEventListener('pointerleave',delayHide);
    el.addEventListener('focus',()=>show(el));
    el.addEventListener('blur',delayHide);
    if(el instanceof HTMLButtonElement)el.addEventListener('click',()=>show(el));
  }
  card.addEventListener('pointerenter',()=>clearTimeout(timeout));
  card.addEventListener('pointerleave',delayHide);
  document.addEventListener('keydown',e=>{if(e.key==='Escape')hide();});
  document.addEventListener('pointerdown',e=>{if(active && !active.contains(e.target as Node)&&!card.contains(e.target as Node))hide();});
  addEventListener('resize',position);addEventListener('scroll',hide,{passive:true,capture:true});
  // Keep Starlight's generated heading anchors and our shared scrollspy. Mark actual
  // summary groups and member headings, including their heading wrappers.
  const members = [...document.querySelectorAll<HTMLElement>('[data-api-member]')];
  if(members.length){
    document.documentElement.classList.add('api-reference-page');
    const tocLinks=[...document.querySelectorAll<HTMLAnchorElement>('docs-toc a[href^="#"], docs-mobile-toc a[href^="#"]')];
    const headingFor=(id:string)=>document.getElementById(id);
    const linksFor=(id:string)=>tocLinks.filter(link=>decodeURIComponent(link.hash.slice(1))===id);
    const wrapperFor=(heading:HTMLElement)=>heading.closest('.sl-heading-wrapper') || heading;
    const rename=(heading:HTMLElement,label:string,icon?:Element|null)=>{
      const anchor=heading.querySelector('a');
      heading.replaceChildren(...(icon?[icon.cloneNode(true)]:[]),document.createTextNode(label),...(anchor?[anchor]:[]));
      const permalink=wrapperFor(heading).querySelector('.sl-anchor-link');
      if(permalink){permalink.setAttribute('aria-label','Link to '+label);const accessible=permalink.querySelector('.sr-only');if(accessible)accessible.textContent='Link to '+label;}
      else if(anchor)anchor.setAttribute('aria-label','Link to '+label);
    };
    const labelLink=(link:HTMLAnchorElement,label:string,icon?:Element|null)=>{
      const span=document.createElement('span');span.textContent=label;span.title=label;
      link.replaceChildren(...(icon?[icon.cloneNode(true)]:[]),span);
    };
    for(const summary of document.querySelectorAll('.api-summary:not(details *)')){
      const previous=summary.previousElementSibling;
      const heading=previous?.matches('h3[id]')?previous:previous?.querySelector('h3[id]');
      if(!(heading instanceof HTMLElement))continue;
      heading.classList.add('api-summary-heading');
      wrapperFor(heading).classList.add('api-summary-heading-wrapper');
      linksFor(heading.id).forEach(link=>link.classList.add('api-toc-summary-group'));
    }
    for(const heading of document.querySelectorAll<HTMLElement>('.sl-markdown-content h2[id]')){
      const label=heading.textContent?.replace(/Section titled.*$/,'').trim()||'';
      if(!heading.id.endsWith('-reference'))continue;
      const clean=label.replace(/ reference$/i,'');
      heading.classList.add('api-group-heading');
      wrapperFor(heading).classList.add('api-group-heading-wrapper');
      rename(heading,clean);
      linksFor(heading.id).forEach(link=>{link.classList.add('api-toc-group');labelLink(link,clean);});
    }
    for(const member of members){
      const heading=headingFor(member.dataset.apiMember||'');
      if(!heading)continue;
      const icon=member.querySelector('.api-member-icon-template svg');
      const label=member.dataset.memberName||heading.textContent||'';
      heading.classList.add('api-member-heading');
      wrapperFor(heading).classList.add('api-member-heading-wrapper');
      rename(heading,label.replace(/\(\)$/,''),icon);
      for(const link of linksFor(heading.id)){
        link.classList.add('api-toc-member');
        labelLink(link,label,icon);
      }
    }
    const title=document.getElementById('_top')?.textContent?.trim();
    if(title)linksFor('_top').forEach(link=>labelLink(link,title));
    // Bring the active member into the independent desktop rail, without
    // scrolling the article or overriding a reader's manual rail scrolling.
    const rail=document.querySelector<HTMLElement>('.right-sidebar');
    const toc=rail?.querySelector('docs-toc');
    if(rail&&toc){
      const reveal=()=>{
        if(rail.matches(':hover'))return;
        const link=toc.querySelector<HTMLElement>('a[aria-current="true"]');
        if(!link)return;
        const row=link.getBoundingClientRect(), box=rail.getBoundingClientRect();
        if(row.top<box.top+4)rail.scrollTop+=row.top-box.top-4;
        else if(row.bottom>box.bottom-4)rail.scrollTop+=row.bottom-box.bottom+4;
      };
      new MutationObserver(reveal).observe(toc,{subtree:true,attributes:true,attributeFilter:['aria-current']});
      reveal();
    }
  }
</script>
