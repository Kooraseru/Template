{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CI credential catalog",
  "type": "object",
  "properties": {
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "github-context"
              },
              "discovery": {
                "enum": [
                  "automatic",
                  "listed"
                ]
              },
              "secrets": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(?![Gg][Ii][Tt][Hh][Uu][Bb]_)(?!gh[pousr]_)(?!github_pat_)[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            },
            "required": [
              "provider",
              "discovery"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "oidc"
              },
              "endpoint": {
                "type": "string",
                "pattern": "^https://"
              },
              "audience": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider",
              "endpoint",
              "audience"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "command"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Executable and arguments. Requests arrive as JSON on stdin."
              }
            },
            "required": [
              "provider",
              "command"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "verifiers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "github"
              }
            },
            "required": [
              "provider"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "provider": {
                "const": "command"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Executable and arguments. Requests arrive as JSON on stdin."
              }
            },
            "required": [
              "provider",
              "command"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "selection": {
                "const": "named"
              },
              "name": {
                "type": "string",
                "pattern": "^(?![Gg][Ii][Tt][Hh][Uu][Bb]_)(?!gh[pousr]_)(?!github_pat_)[A-Za-z_][A-Za-z0-9_]*$"
              },
              "sources": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "secret",
                    "variable"
                  ]
                },
                "minItems": 1
              },
              "permissions": {
                "type": "object",
                "properties": {
                  "classic": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "repository": {
                    "type": "object",
                    "additionalProperties": {
                      "enum": [
                        "read",
                        "write"
                      ]
                    }
                  },
                  "organization": {
                    "type": "object",
                    "additionalProperties": {
                      "enum": [
                        "read",
                        "write"
                      ]
                    }
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "selection",
              "name",
              "sources"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "selection": {
                "const": "capability"
              },
              "verifier": {
                "type": "string",
                "minLength": 1
              },
              "requirements": {
                "type": "object"
              },
              "fallbackName": {
                "type": "string",
                "pattern": "^(?![Gg][Ii][Tt][Hh][Uu][Bb]_)(?!gh[pousr]_)(?!github_pat_)[A-Za-z_][A-Za-z0-9_]*$",
                "description": "Optional explicitly bound migration credential."
              },
              "candidateSources": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                },
                "description": "Allowed sources for custom verifiers."
              },
              "service": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              }
            },
            "required": [
              "selection",
              "verifier",
              "requirements"
            ],
            "additionalProperties": false
          }
        ]
      },
      "required": [
        "app_id",
        "app_private_key",
        "bootstrap_token",
        "projects_token",
        "rulesets_token"
      ]
    },
    "profiles": {
      "type": "object",
      "properties": {
        "source-ci": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Ordered source IDs. Choose one hosted transport and optional command sources."
            },
            "bootstrap": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "delegate": {
              "type": "boolean"
            }
          },
          "required": [
            "sources",
            "bootstrap",
            "delegate"
          ],
          "additionalProperties": false
        },
        "validate": {
          "type": "object",
          "properties": {
            "sources": {
              "const": []
            },
            "bootstrap": {
              "const": []
            },
            "delegate": {
              "const": false
            }
          },
          "required": [
            "sources",
            "bootstrap",
            "delegate"
          ],
          "additionalProperties": false
        },
        "remote-read": {
          "type": "object",
          "properties": {
            "sources": {
              "const": []
            },
            "bootstrap": {
              "const": []
            },
            "delegate": {
              "const": false
            }
          },
          "required": [
            "sources",
            "bootstrap",
            "delegate"
          ],
          "additionalProperties": false
        },
        "local": {
          "type": "object",
          "properties": {
            "sources": {
              "const": []
            },
            "bootstrap": {
              "const": []
            },
            "delegate": {
              "const": false
            }
          },
          "required": [
            "sources",
            "bootstrap",
            "delegate"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source-ci",
        "validate",
        "remote-read",
        "local"
      ],
      "additionalProperties": false
    },
    "neutralCheck": {
      "type": "object",
      "properties": {
        "checks": {
          "const": "write"
        }
      },
      "required": [
        "checks"
      ],
      "additionalProperties": {
        "enum": [
          "read",
          "write"
        ]
      }
    }
  },
  "required": [
    "sources",
    "verifiers",
    "roles",
    "profiles",
    "neutralCheck"
  ],
  "additionalProperties": false
}
