{
  // Values come from the runtime source. Never paste tokens here.
  "sources": {
    "actions": { "provider": "environment" }
  },
  "environments": {
    "ci-bootstrap": {
      "app_id": "vars.CI_APP_ID",
      "app_private_key": "secrets.CI_APP_PRIVATE_KEY",
      "bootstrap_token": "secrets.CI_TOKEN"
    },
    "ci-projects": { "projects_token": "secrets.CI_TOKEN" },
    "ci-rulesets": {
      "app_id": "vars.CI_APP_ID",
      "app_private_key": "secrets.CI_APP_PRIVATE_KEY"
    },
    "ci-reporting": {
      "app_id": "vars.CI_APP_ID",
      "app_private_key": "secrets.CI_APP_PRIVATE_KEY"
    }
  },
  "verifiers": {
    "github": {
      "provider": "github"
    }
  },
  // Roles describe what operations need. Environments bind those roles to fixed aliases.
  "roles": {
    "app_id": {
      "selection": "named",
      "name": "CI_APP_ID",
      "sources": [
        "secret",
        "variable"
      ],
      "permissions": {
        "classic": [],
        "repository": {},
        "organization": {}
      }
    },
    "app_private_key": {
      "selection": "named",
      "name": "CI_APP_PRIVATE_KEY",
      "sources": [
        "secret"
      ],
      "permissions": {
        "classic": [],
        "repository": {},
        "organization": {}
      }
    },
    // For migration, a capability role can add "fallbackName" for a verified PAT.
    // Use a named role to explicitly pin a credential whose grants cannot be inspected.
    "bootstrap_token": {
      "selection": "capability",
      "verifier": "github",
      "requirements": {
        "classic": [
          "repo",
          "workflow"
        ],
        "repository": {
          "contents": "write",
          "workflows": "write"
        },
        "organization": {}
      }
    },
    "projects_token": {
      "selection": "capability",
      "verifier": "github",
      "requirements": {
        "classic": [
          "project"
        ],
        "repository": {},
        "organization": {
          "organization_projects": "write"
        }
      }
    },
    "rulesets_token": {
      "selection": "capability",
      "verifier": "github",
      "requirements": {
        "classic": [
          "repo"
        ],
        "repository": {
          "administration": "write"
        },
        "organization": {}
      }
    }
  },
  "profiles": {
    "source-ci": {
      "bootstrap": [
        "app_id",
        "app_private_key",
        "bootstrap_token"
      ],
      "delegate": true,
      "bootstrapEnvironment": "ci-bootstrap",
      "reportingEnvironment": "ci-reporting",
      "sources": [
        "actions"
      ]
    },
    "validate": {
      "bootstrap": [],
      "delegate": false,
      "sources": []
    },
    "remote-read": {
      "bootstrap": [],
      "delegate": false,
      "sources": []
    },
    "local": {
      "bootstrap": [],
      "delegate": false,
      "sources": []
    }
  },
  "neutralCheck": {
    "checks": "write"
  }
}
