{
  // Values come from the runtime source. Never paste tokens here.
  "sources": {
    "actions": {
      "provider": "github-context",
      "discovery": "automatic"
    }
    // To use a broker, add a comma above and uncomment this example.
    // "broker": { "provider": "oidc", "endpoint": "https://broker.example/credentials", "audience": "template-ci" }
  },
  "verifiers": {
    "github": {
      "provider": "github"
    }
  },
  // Roles describe what operations need. CI Start can discover PATs at runtime.
  // Generated jobs use the listed fallback keys or the configured broker.
  "roles": {
    "app_id": {
      "selection": "named",
      "name": "CI_APP_ID",
      "sources": [
        "secret",
        "variable"
      ],
      "permissions": {
        "classic": [],
        "repository": {},
        "organization": {}
      }
    },
    "app_private_key": {
      "selection": "named",
      "name": "CI_APP_PRIVATE_KEY",
      "sources": [
        "secret"
      ],
      "permissions": {
        "classic": [],
        "repository": {},
        "organization": {}
      }
    },
    // For migration, a capability role can add "fallbackName" for a verified PAT.
    // Use a named role to explicitly pin a credential whose grants cannot be inspected.
    "bootstrap_token": {
      "selection": "capability",
      "verifier": "github",
      "requirements": {
        "classic": [
          "repo",
          "workflow"
        ],
        "repository": {
          "contents": "write",
          "workflows": "write"
        },
        "organization": {}
      }
    },
    "projects_token": {
      "selection": "capability",
      //"fallbackName": "CI_PROJECTS_TOKEN",
      "verifier": "github",
      "requirements": {
        "classic": [
          "project"
        ],
        "repository": {},
        "organization": {
          "organization_projects": "write"
        }
      }
    },
    "rulesets_token": {
      "selection": "capability",
      //"fallbackName": "CI_RULESETS_TOKEN",
      "verifier": "github",
      "requirements": {
        "classic": [
          "repo"
        ],
        "repository": {
          "administration": "write"
        },
        "organization": {}
      }
    }
  },
  "profiles": {
    "source-ci": {
      "bootstrap": [
        "app_id",
        "app_private_key",
        "bootstrap_token"
      ],
      "delegate": true,
      // Select ["broker"] here to use a configured OIDC broker.
      "sources": [
        "actions"
      ]
    },
    "validate": {
      "bootstrap": [],
      "delegate": false,
      "sources": []
    },
    "remote-read": {
      "bootstrap": [],
      "delegate": false,
      "sources": []
    },
    "local": {
      "bootstrap": [],
      "delegate": false,
      "sources": []
    }
  },
  "neutralCheck": {
    "checks": "write"
  }
}
