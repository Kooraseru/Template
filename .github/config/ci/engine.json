{
  "version": 1,
  "triggers": {
    "push": "build",
    "pull_request": "review",
    "workflow_dispatch": "validation"
  },
  "operations": {
    "review": {
      "mode": "readonly",
      "events": [
        "pull_request"
      ],
      "components": [
        "quality/*"
      ]
    },
    "validation": {
      "mode": "readonly",
      "events": [
        "workflow_dispatch"
      ],
      "components": [
        "quality/*"
      ]
    },
    "build": {
      "mode": "generated",
      "events": [
        "push",
        "workflow_dispatch"
      ],
      "components": [
        "*"
      ],
      "branch": "default"
    }
  }
}
