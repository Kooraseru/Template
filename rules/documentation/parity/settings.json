{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "geometryTolerance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "commissioning": {
      "type": "boolean",
      "description": "Permit missing entire reference scenarios as explicitly unverified while acquiring initial baselines. Never permits a malformed or partial baseline.",
      "default": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "classNormalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replace": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "replacement"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "replacement": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route",
          "root",
          "viewport"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "route": {
            "type": "string",
            "pattern": "^/(?!/)"
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "componentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "classes"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "classes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "classes",
              "reason"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "classes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "pairedSources": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "sources",
    "candidates"
  ]
}
