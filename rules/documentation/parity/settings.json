{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "geometryTolerance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "commissioning": {
      "type": "boolean",
      "description": "Permit missing entire reference scenarios as explicitly unverified while acquiring initial baselines. Never permits a malformed or partial baseline.",
      "default": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "sources"
  ]
}
