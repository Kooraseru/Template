{
  "rules": {
    "schema": 1,
    "retention_days": 30,
    "staging_prefix": "ci-validation-",
    "default_reuse_identity": "exact_commit",
    "reuse_identities": [
      "exact_commit",
      "source_tree"
    ],
    "native_runners": {
      "windows": "win32",
      "macos": "darwin"
    },
    "required_receipt_fields": [
      "schema",
      "repository",
      "tested_sha",
      "tree",
      "source_manifest_sha256",
      "controller_hash",
      "created_at",
      "pr",
      "targets"
    ],
    "required_target_fields": [
      "name",
      "source_sha",
      "tree",
      "source_manifest_sha256",
      "fingerprint",
      "reuse_identity",
      "result",
      "execution",
      "files",
      "logs"
    ],
    "required_bundle_files": [
      "provenance.json",
      "manifest.json",
      "distribution.tar.gz"
    ],
    "receipt_asset": "receipt.json",
    "archive_asset": "bundle.tar.gz",
    "max_archive_bytes": 2000000000,
    "contract_paths": [
      "security/receipts/ruleset.json",
      "security/receipts/policy.json",
      "ci/receipts/policy.json",
      "ci/receipts/ruleset.json"
    ]
  },
  "cases": {
    "authentication": [
      {
        "name": "admin source push with execution authorization is accepted",
        "kind": "hosted",
        "run_patch": {
          "event": "push"
        },
        "source_authorization": {
          "kind": "admin-source-push",
          "actor": "admin",
          "source_sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
        },
        "valid": true
      },
      {
        "name": "admin source merge with execution authorization is accepted",
        "kind": "hosted",
        "run_patch": {
          "event": "push"
        },
        "source_authorization": {
          "kind": "admin-merge",
          "actor": "admin",
          "source_sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "pr": 17
        },
        "valid": true
      },
      {
        "name": "source authorization for another SHA is rejected",
        "kind": "hosted",
        "run_patch": {
          "event": "push"
        },
        "source_authorization": {
          "kind": "admin-source-push",
          "actor": "admin",
          "source_sha": "ffffffffffffffffffffffffffffffffffffffff"
        },
        "valid": false
      },
      {
        "name": "source authorization cannot override admin permissions",
        "kind": "hosted",
        "admin": false,
        "run_patch": {
          "event": "push"
        },
        "source_authorization": {
          "kind": "admin-source-push",
          "actor": "admin",
          "source_sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
        },
        "valid": false
      },
      {
        "name": "diagnostic hosted receipt is not official validation",
        "kind": "hosted",
        "diagnostic": true,
        "valid": false
      },
      {
        "name": "explicit diagnostic cache capability accepts diagnostic evidence",
        "kind": "hosted",
        "diagnostic": true,
        "allow_diagnostic": true,
        "valid": true
      },
      {
        "name": "originating publication capability accepts pending run",
        "kind": "hosted",
        "allow_pending": true,
        "run_patch": {
          "status": "in_progress",
          "conclusion": null
        },
        "valid": true
      },
      {
        "name": "valid admin signature",
        "kind": "signature",
        "valid": true
      },
      {
        "name": "contributor claim cannot pass",
        "kind": "claim",
        "valid": false
      },
      {
        "name": "tampered signature",
        "kind": "signature",
        "tamper": true,
        "valid": false
      },
      {
        "name": "revoked signer",
        "kind": "signature",
        "revoked": true,
        "valid": false
      },
      {
        "name": "unknown signer",
        "kind": "signature",
        "unknown": true,
        "valid": false
      },
      {
        "name": "former admin",
        "kind": "signature",
        "admin": false,
        "valid": false
      },
      {
        "name": "wrong repository",
        "kind": "signature",
        "repository": "other/project",
        "valid": false
      },
      {
        "name": "expired receipt",
        "kind": "signature",
        "age_days": 31,
        "valid": false
      },
      {
        "name": "future receipt",
        "kind": "signature",
        "age_days": -1,
        "valid": false
      },
      {
        "name": "admin source dispatch",
        "kind": "hosted",
        "valid": true
      },
      {
        "name": "automatic push is not admin validation",
        "kind": "hosted",
        "run_patch": {
          "event": "push"
        },
        "valid": false
      },
      {
        "name": "PR workflow is not validation authority",
        "kind": "hosted",
        "run_patch": {
          "event": "pull_request"
        },
        "valid": false
      },
      {
        "name": "wrong controller branch",
        "kind": "hosted",
        "run_patch": {
          "head_branch": "feature"
        },
        "valid": false
      },
      {
        "name": "wrong controller SHA",
        "kind": "hosted",
        "run_patch": {
          "head_sha": "ffffffffffffffffffffffffffffffffffffffff"
        },
        "valid": false
      },
      {
        "name": "failed hosted run",
        "kind": "hosted",
        "run_patch": {
          "conclusion": "failure"
        },
        "valid": false
      },
      {
        "name": "unfinished hosted run",
        "kind": "hosted",
        "run_patch": {
          "conclusion": null
        },
        "valid": false
      },
      {
        "name": "wrong hosted workflow",
        "kind": "hosted",
        "run_patch": {
          "path": ".github/workflows/other.yml"
        },
        "valid": false
      },
      {
        "name": "fork hosted run",
        "kind": "hosted",
        "run_patch": {
          "head_repository": {
            "full_name": "other/project"
          }
        },
        "valid": false
      },
      {
        "name": "non-admin dispatch",
        "kind": "hosted",
        "admin": false,
        "valid": false
      },
      {
        "name": "verified first-install bootstrap",
        "kind": "hosted",
        "bootstrap": true,
        "allow_bootstrap": true,
        "run_patch": {
          "head_branch": "activation"
        },
        "valid": true
      },
      {
        "name": "bootstrap cannot override installed contract",
        "kind": "hosted",
        "bootstrap": true,
        "allow_bootstrap": false,
        "run_patch": {
          "head_branch": "activation"
        },
        "valid": false
      },
      {
        "name": "bootstrap cannot override admin permission",
        "kind": "hosted",
        "bootstrap": true,
        "allow_bootstrap": true,
        "admin": false,
        "run_patch": {
          "head_branch": "activation"
        },
        "valid": false
      },
      {
        "name": "manual hosted receipt with null source authorization",
        "kind": "hosted",
        "source_authorization": null,
        "valid": true
      }
    ],
    "reuse": [
      {
        "name": "exact commit reuse",
        "valid": true
      },
      {
        "name": "changed merge SHA invalidates exact target",
        "patch": {
          "source_sha": "ffffffffffffffffffffffffffffffffffffffff"
        },
        "valid": false
      },
      {
        "name": "tree opt-in reuses changed merge SHA",
        "tree_mode": true,
        "patch": {
          "source_sha": "ffffffffffffffffffffffffffffffffffffffff"
        },
        "valid": true
      },
      {
        "name": "changed tree invalidates opt-in",
        "tree_mode": true,
        "patch": {
          "tree": "ffffffffffffffffffffffffffffffffffffffff"
        },
        "valid": false
      },
      {
        "name": "changed source manifest",
        "tree_mode": true,
        "patch": {
          "source_manifest_sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        },
        "valid": false
      },
      {
        "name": "changed build inputs",
        "patch": {
          "fingerprint": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        },
        "valid": false
      },
      {
        "name": "changed target",
        "patch": {
          "name": "other-target"
        },
        "valid": false
      },
      {
        "name": "changed reuse declaration",
        "patch": {
          "reuse_identity": "source_tree"
        },
        "valid": false
      }
    ],
    "execution": [
      {
        "name": "native Windows x64",
        "runner": "windows-2025",
        "target": "x86_64-pc-windows-msvc",
        "execution": {
          "kind": "native",
          "os": "win32",
          "arch": "x64"
        },
        "valid": true
      },
      {
        "name": "Linux cannot satisfy Windows",
        "runner": "windows-2025",
        "target": "x86_64-pc-windows-msvc",
        "execution": {
          "kind": "container",
          "os": "linux",
          "arch": "x64"
        },
        "valid": false
      },
      {
        "name": "emulated macOS receipt rejected",
        "runner": "macos-15",
        "target": "aarch64-apple-darwin",
        "execution": {
          "kind": "container",
          "os": "darwin",
          "arch": "arm64"
        },
        "valid": false
      },
      {
        "name": "native macOS ARM64",
        "runner": "macos-15",
        "target": "aarch64-apple-darwin",
        "execution": {
          "kind": "native",
          "os": "darwin",
          "arch": "arm64"
        },
        "valid": true
      },
      {
        "name": "wrong native architecture",
        "runner": "macos-15",
        "target": "aarch64-apple-darwin",
        "execution": {
          "kind": "native",
          "os": "darwin",
          "arch": "x64"
        },
        "valid": false
      }
    ],
    "comparison": [
      {
        "name": "matching contributor and admin",
        "valid": true,
        "differences": 0
      },
      {
        "name": "nondeterministic output reported",
        "changed_files": true,
        "valid": true,
        "differences": 1
      },
      {
        "name": "reproducible mismatch rejected",
        "changed_files": true,
        "reproducible": true,
        "valid": false
      },
      {
        "name": "changed PR base rejected",
        "base_changed": true,
        "valid": false
      },
      {
        "name": "missing coverage rejected",
        "missing_target": true,
        "valid": false
      },
      {
        "name": "failed contributor target rejected",
        "failed_target": true,
        "valid": false
      }
    ],
    "unsafe_archives": [
      {
        "name": "archive symlink",
        "path": "link",
        "type": "2",
        "link": "../outside"
      },
      {
        "name": "archive traversal",
        "path": "../outside",
        "type": "0"
      }
    ],
    "download_layouts": [
      {
        "name": "flat single artifact",
        "flat": true
      },
      {
        "name": "named artifact directory",
        "flat": false
      }
    ],
    "source_files": [
      {
        "path": "source.txt",
        "contents": "first source\n"
      },
      {
        "path": ".gitignore",
        "contents": "build/\n"
      }
    ],
    "source_changes": [
      {
        "path": "source.txt",
        "contents": "changed source\n"
      }
    ],
    "fixture": {
      "schema": 1,
      "repository": "owner/project",
      "tested_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "tree": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "source_manifest_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "controller_hash": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "controller_sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "created_at": "@now",
      "pr": {
        "number": 1,
        "head_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "base_sha": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "targets": [
        {
          "name": "linux-x64",
          "source_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "tree": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "source_manifest_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "fingerprint": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
          "reuse_identity": "exact_commit",
          "result": "success",
          "execution": {
            "kind": "native",
            "os": "linux",
            "arch": "x64"
          },
          "resolved_fingerprint": "c4567a06ebb93a5d31fb49988b6d219a862cc076770a88c4e0fb0596db538f17",
          "files": [
            {
              "path": "provenance.json",
              "sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            },
            {
              "path": "manifest.json",
              "sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            },
            {
              "path": "distribution.tar.gz",
              "sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            }
          ],
          "logs": [
            {
              "path": "commands.log",
              "sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            }
          ]
        }
      ]
    },
    "hosted_run": {
      "event": "workflow_dispatch",
      "head_branch": "source",
      "head_sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "conclusion": "success",
      "path": ".github/workflows/ci.yml",
      "head_repository": {
        "full_name": "owner/project"
      },
      "actor": {
        "login": "admin"
      }
    },
    "test_key": {
      "private_key": "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIJ1hsZ3v/VpguoRK9JLsLMREScVpezJpGXA7rAMcrn9g\n-----END PRIVATE KEY-----\n",
      "public_key": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo=\n-----END PUBLIC KEY-----\n"
    }
  }
}
