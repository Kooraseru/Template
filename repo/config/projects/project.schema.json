{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/Kooraseru/Template/blob/source/repo/config/projects/project.schema.json",
	"title": "GitHub Project blueprint",
	"type": "object",
	"additionalProperties": false,
	"required": ["project", "fields"],
	"properties": {
		"project": {
			"type": "object",
			"additionalProperties": false,
			"required": ["title", "description", "readme_file", "public"],
			"properties": {
				"owner": { "type": "string", "minLength": 1 },
				"title": { "type": "string", "minLength": 1 },
				"description": { "type": "string" },
				"readme_file": { "type": "string", "minLength": 1 },
				"public": { "type": "boolean" }
			}
		},
		"fields": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "data_type"],
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"data_type": {
						"type": "string",
						"enum": ["TEXT", "NUMBER", "DATE", "SINGLE_SELECT"]
					},
					"options": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["name", "color", "description"],
							"properties": {
								"name": { "type": "string", "minLength": 1 },
								"color": {
									"type": "string",
									"enum": ["GRAY", "BLUE", "GREEN", "YELLOW", "ORANGE", "RED", "PINK", "PURPLE"]
								},
								"description": { "type": "string" }
							}
						}
					}
				}
			}
		},
		"views": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "layout"],
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"layout": {
						"type": "string",
						"enum": ["TABLE_LAYOUT", "BOARD_LAYOUT", "ROADMAP_LAYOUT"]
					},
					"filter": { "type": "string" },
					"visible_fields": {
						"type": "array",
						"items": { "type": "string", "minLength": 1 }
					}
				}
			}
		}
	}
}
