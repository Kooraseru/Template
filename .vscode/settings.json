
{
	// Generic Workbench Bridge external workspace client.
	"workbenchBridge.workspaceCommands": [
		["node", "dependencies/packages/editorIntegration/client.cjs"]
	],
	// File Associations
	"files.associations": {
		".luaurc": "jsonc"
	},

	// Explorer
	// Generated discovery files; edit the canonical files under .vscode/config.
	"files.exclude": {
		".luaurc": true,
		"tsconfig.json": true
	},
	"explorer.compactFolders": true,
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		"*.json": "${capture}.schema.json",
		"init.luau": "*.luau",
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, node_modules",
		"tsconfig.json": "tsconfig.*.json",
		"dependencies.json": "dependencies.lock, dependencies.schema.json"
	},

	// Luau Language Server
	"luau-lsp.platform.type": "standard",
	"luau-lsp.analyzeLuaFiles": false,
	"luau-lsp.ignoreGlobs": [
		"**/_Index/**",
		"**/build/dependencies/**",
		"rules-old/**"
	],
	"luau-lsp.diagnostics.workspace": true,
	"luau-lsp.sourcemap.enabled": false,
	"luau-lsp.sourcemap.autogenerate": false,
	"luau-lsp.server.baseLuaurc": ".vscode/config/luau/.luaurc",
	"luau-lsp.fflags.enableNewSolver": true,
	"luau-lsp.fflags.sync": false,

	// Luau Editor
	"[luau]": {
		"editor.formatOnSave": false,
		"editor.codeActionsOnSave": {
			"source.fixAll": "never",
			"source.organizeImports": "never"
		},
		"editor.insertSpaces": false,
		"editor.tabSize": 4
	},

	// JSON Schemas
	"json.schemas": [
		{
			"fileMatch": ["/dependencies/dependencies.json"],
			"url": "./dependencies/dependencies.schema.json"
		},
		{
			"fileMatch": ["/.vscode/config/rules.json"],
			"url": "./.vscode/config/rules.schema.json"
		},
		{
			"fileMatch": ["/.vscode/config/workflow.json"],
			"url": "./.vscode/config/workflow.schema.json"
		},
		{
			"fileMatch": [
				".github/work/projects/**/project.json"
			],
			"url": "./.github/work/projects/project.schema.json"
		}
	]
}
