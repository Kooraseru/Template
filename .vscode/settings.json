{
  "githubLocalActions.actCommand": "act --pull=false --bind",
  "luau-lsp.fflags.enableNewSolver": true,
  "luau-lsp.platform.type": "standard",
  "luau-lsp.analyzeLuaFiles": false,
  "luau-lsp.diagnostics.workspace": true,
  "luau-lsp.sourcemap.enabled": false,
  "luau-lsp.sourcemap.autogenerate": false,
  "luau-lsp.server.baseLuaurc": ".luaurc",
  "preflight.planFile": "repo/config/ci/preflight.json",
  "mandolin.luteExecPath": "${workspaceFolder}/build/run/dependencies/artifacts/lute/1.0.0/lute.exe",
  "mandolin.lintConfigPath": "${workspaceFolder}/repo/config/luau/lute/.config.luau",
  "json.schemas": [
    {
      "fileMatch": ["repo/config/projects/**/project.json"],
      "url": "./repo/config/projects/project.schema.json"
    }
  ],
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "stylua.targetReleaseVersion": "v2.6.0"
}
