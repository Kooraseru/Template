{
  "githubLocalActions.actCommand": "act --pull=false --bind",
  "luau-lsp.fflags.enableNewSolver": true,
  "luau-lsp.platform.type": "standard",
  "luau-lsp.analyzeLuaFiles": false,
  "luau-lsp.diagnostics.workspace": true,
  "luau-lsp.sourcemap.enabled": false,
  "luau-lsp.sourcemap.autogenerate": false,
  "luau-lsp.server.baseLuaurc": ".luaurc",
  "preflight.planFile": ".vscode/preflight/plan.json",
  "mandolin.luteExecPath": "../../../build/run/dependencies/lute/1.0.1-nightly.20261104/lute.exe",
  "mandolin.foremanTomlPath": ".vscode/luau/lute/foreman.toml",
  "mandolin.lintConfigPath": ".vscode/luau/lute/config.luau",
  "stylua.configPath": ".vscode/luau/stylua/.stylua.toml",
  "json.schemas": [
    {
      "fileMatch": [".github/work/projects/**/project.json"],
      "url": "./.github/work/projects/project.schema.json"
    }
  ],
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.fixAll": "never",
      "source.organizeImports": "never"
    },
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "stylua.targetReleaseVersion": "v2.6.0"
}
