{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CI: Run local workflows",
			"type": "process",
			"command": "C:/msys64/usr/bin/bash.exe",
			"args": [
				"-lc",
				"cd \"$(cygpath -u '${workspaceFolder}')\" && .github/ci/tooling/local-actions/run.sh"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"runOptions": {
				"instanceLimit": 1
			},
			"problemMatcher": []
		},
		{
			"label": "Lute: Install pinned runtime",
			"type": "process",
			"command": "C:/msys64/usr/bin/bash.exe",
			"args": [
				"-lc",
				"cd \"$(cygpath -u '${workspaceFolder}')\" && .github/ci/tooling/lute/bootstrap.sh --install"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Lute: Lint Luau",
			"type": "process",
			"command": "C:/msys64/usr/bin/bash.exe",
			"args": [
				"-lc",
				"cd \"$(cygpath -u '${workspaceFolder}')/.vscode/luau/lute\" && ../../../.github/ci/tooling/lute/bootstrap.sh lint --config config.luau --json ../../../"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}
