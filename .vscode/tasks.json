{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Diagnostics: Workspace",
			"type": "process",
			"command": "node",
			"args": [
				"${workspaceFolder}/.vscode/preflight/workspace-diagnostics.js",
				"C:/msys64/usr/bin/bash.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": false,
				"reveal": "never",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": false
			},
			"isBackground": true,
			"runOptions": {
				"runOn": "folderOpen",
				"instanceLimit": 1
			},
			"problemMatcher": {
				"owner": "workspace-diagnostics",
				"source": "Workspace diagnostics",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+): (error|warning): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^WORKSPACE_DIAGNOSTICS_BEGIN$",
					"endsPattern": "^WORKSPACE_DIAGNOSTICS_END$"
				}
			}
		},
		{
			"label": "CI: Run local workflows",
			"type": "process",
			"command": "C:/msys64/usr/bin/bash.exe",
			"args": [
				"-lc",
				"cd \"$(cygpath -u '${workspaceFolder}')\" && .github/ci/tooling/local-actions/run.sh"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"runOptions": {
				"instanceLimit": 1
			},
			"problemMatcher": []
		},
		{
			"label": "Lute: Install pinned runtime",
			"type": "process",
			"command": "C:/msys64/usr/bin/bash.exe",
			"args": [
				"-lc",
				"cd \"$(cygpath -u '${workspaceFolder}')\" && .github/ci/tooling/lute/bootstrap.sh --install"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Lute: Lint Luau",
			"type": "process",
			"command": "C:/msys64/usr/bin/bash.exe",
			"args": [
				"-lc",
				"cd \"$(cygpath -u '${workspaceFolder}')/.vscode/luau/lute\" && ../../../.github/ci/tooling/lute/bootstrap.sh lint --config config.luau --json ../../../"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}
