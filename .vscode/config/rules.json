{
  "defaultSeverity": "warning",
  "fixtureSeverity": "warning",
  "overrides": {},
  "ruleSettings": {
    "rules/languages/luau/files/file-system": {
      "sectionMarkers": {
        "allowed": [
          "Services",
          "Modules",
          "Types",
          "Constants",
          "Variables",
          "Helpers",
          "Constructor",
          "Functions",
          "Methods",
          "Lifecycle",
          "Initialization"
        ],
        "disallowed": [
          "Imports",
          "Module",
          "Public Methods",
          "Private Methods"
        ]
      }
    }
  }
}
