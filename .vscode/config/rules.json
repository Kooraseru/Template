{
  "defaults": {
    "severity": "warning",
    "fixtureSeverity": "info"
  },
  "rules": {
    "luau/const-bindings": {
      "severity": "info"
    },
    "luau/script-layout": {
      "settings": {
        "entryPoints": [
          "dependencies/packages/core/hostRunner/run.luau",
          ".github/components/distribution/packages/build/run.luau",
          ".github/components/governance/branches/build/run.luau",
          ".github/components/work/maintenance.luau",
          ".github/components/source/build/run.luau",
          ".github/components/distribution/releases/build/run.luau"
        ]
      }
    },
    "luau/module-roots": {
      "severity": "info"
    },
    "luau/phase-comments": {
      "severity": "info"
    },
    "luau/file-system": {
      "settings": {
        "sectionMarkers": {
          "allowed": [
            "Services",
            "Modules",
            "Types",
            "Constants",
            "Variables",
            "Helpers",
            "Constructor",
            "Functions",
            "Methods",
            "Lifecycle",
            "Initialization"
          ],
          "disallowed": [
            "Imports",
            "Module",
            "Public Methods",
            "Private Methods"
          ]
        }
      }
    },
    "documentation/parity": {
      "severity": "warning",
      "settings": {
        "geometryTolerance": 1,
        "commissioning": false,
        "sources": [
          {
            "id": "base-part",
            "url": "https://create.roblox.com/docs/reference/engine/classes/BasePart",
            "reference": "rules/documentation/parity/references/base-part"
          },
          {
            "id": "tween-service",
            "url": "https://create.roblox.com/docs/reference/engine/classes/TweenService",
            "reference": "rules/documentation/parity/references/tween-service"
          },
          {
            "id": "user-input-service",
            "url": "https://create.roblox.com/docs/reference/engine/classes/UserInputService",
            "reference": "rules/documentation/parity/references/user-input-service"
          },
          {
            "id": "vector3",
            "url": "https://create.roblox.com/docs/reference/engine/datatypes/Vector3",
            "reference": "rules/documentation/parity/references/vector3"
          },
          {
            "id": "material",
            "url": "https://create.roblox.com/docs/reference/engine/enums/Material",
            "reference": "rules/documentation/parity/references/material"
          },
          {
            "id": "events",
            "url": "https://create.roblox.com/docs/scripting/events",
            "reference": "rules/documentation/parity/references/events"
          },
          {
            "id": "materials",
            "url": "https://create.roblox.com/docs/parts/materials",
            "reference": "rules/documentation/parity/references/materials"
          },
          {
            "id": "engine-classes",
            "url": "https://create.roblox.com/docs/reference/engine/classes",
            "reference": "rules/documentation/parity/references/engine-classes"
          },
          {
            "id": "vector-library",
            "url": "https://create.roblox.com/docs/reference/engine/libraries/vector",
            "reference": "rules/documentation/parity/references/vector-library"
          },
          {
            "id": "engine-reference",
            "url": "https://create.roblox.com/docs/reference/engine",
            "reference": "rules/documentation/parity/references/engine-reference"
          }
        ],
        "classNormalization": {
          "drop": [
            "^web-blox-css-mui-",
            "^web-blox-css-tss-[a-z0-9]+$"
          ],
          "replace": [
            {
              "pattern": "^web-blox-css-tss-[a-z0-9]+-",
              "replacement": ""
            }
          ]
        },
        "candidates": [
          {
            "id": "base-part",
            "route": "/base-part/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "tween-service",
            "route": "/tween-service/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "user-input-service",
            "route": "/user-input-service/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "vector3",
            "route": "/vector3/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "material",
            "route": "/material/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "events",
            "route": "/events/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "materials",
            "route": "/materials/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "engine-classes",
            "route": "/engine-classes/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "vector-library",
            "route": "/vector-library/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          },
          {
            "id": "engine-reference",
            "route": "/",
            "root": "main",
            "viewport": {
              "width": 1440,
              "height": 900
            }
          }
        ],
        "componentPolicy": {
          "required": [
            {
              "tag": "div",
              "classes": [
                "titleRow"
              ]
            },
            {
              "tag": "div",
              "classes": [
                "titleContainer"
              ]
            },
            {
              "tag": "span",
              "classes": [
                "MuiTypography-root",
                "Typography-h1-Typography-root-title",
                "MuiTypography-inherit"
              ]
            },
            {
              "tag": "div",
              "classes": [
                "MuiTypography-root",
                "Typography-body1-Typography-root-signatureContainer",
                "MuiTypography-inherit"
              ]
            },
            {
              "tag": "div",
              "classes": [
                "multilineSignature"
              ]
            },
            {
              "tag": "div",
              "classes": [
                "parametersContainer"
              ]
            },
            {
              "tag": "div",
              "classes": [
                "row"
              ]
            },
            {
              "tag": "span",
              "classes": [
                "Typography-code"
              ]
            }
          ],
          "excluded": []
        },
        "pairedSources": true
      }
    }
  }
}
