{
  "defaults": {
    "severity": "warning",
    "fixtureSeverity": "info"
  },
  "rules": {
    "luau/const-bindings": {
      "severity": "info"
    },
    "luau/script-layout": {
      "settings": {
        "entryPoints": [
          "dependencies/packages/core/hostRunner/run.luau",
          ".github/components/distribution/packages/build/run.luau",
          ".github/components/governance/branches/build/run.luau",
          ".github/components/work/maintenance.luau",
          ".github/components/source/build/run.luau",
          ".github/components/distribution/releases/build/run.luau"
        ]
      }
    },
    "luau/module-roots": {
      "severity": "info"
    },
    "luau/phase-comments": {
      "severity": "info"
    },
    "luau/file-system": {
      "settings": {
        "sectionMarkers": {
          "allowed": [
            "Services",
            "Modules",
            "Types",
            "Constants",
            "Variables",
            "Helpers",
            "Constructor",
            "Functions",
            "Methods",
            "Lifecycle",
            "Initialization"
          ],
          "disallowed": [
            "Imports",
            "Module",
            "Public Methods",
            "Private Methods"
          ]
        }
      }
    }
  }
}
