{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template rules policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "$ref": "#/definitions/severity"
        },
        "fixtureSeverity": {
          "$ref": "#/definitions/severity"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/rule"
      }
    }
  },
  "definitions": {
    "severity": {
      "enum": [
        "error",
        "warning",
        "info",
        "off"
      ]
    },
    "settings": {
      "type": "object"
    },
    "globs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "$ref": "#/definitions/severity"
        },
        "fixtureSeverity": {
          "$ref": "#/definitions/severity"
        },
        "settings": {
          "$ref": "#/definitions/settings"
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/override"
          }
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "$ref": "#/definitions/globs"
        },
        "excludedFiles": {
          "$ref": "#/definitions/globs"
        },
        "severity": {
          "$ref": "#/definitions/severity"
        },
        "settings": {
          "$ref": "#/definitions/settings"
        }
      },
      "required": [
        "files"
      ]
    }
  }
}
