{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@root/*": ["../../../*"]
    },
    "typeRoots": [
      "../../../dependencies/managed/npm/node_modules/@types"
    ],
    "types": ["node"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "../../../**/*.ts",
    "../../../**/*.tsx",
    "../../../**/*.mts",
    "../../../**/*.cts"
  ],
  "exclude": [
    "../../../**/node_modules",
    "../../../**/vendor",
    "../../../build",
    "../../../dependencies/managed",
    "../../../.workspace",
    "../../../rules/luau/**/tests/**",
    "../../../rules-old"
  ]
}