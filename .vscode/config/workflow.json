{
  "dependencies": {
    "command": ["node", "dependencies/packages/core/dependencyLoader/index.ts"],
    "env": { "VSCODE_WORKSPACE_SETUP": "1" },
    "notification": "Preparing workspace providers",
    "status": {
      "running": "Loading providers",
      "passed": "Providers ready",
      "failed": "Provider setup failed"
    }
  },
  "checks": {
    "command": ["node", "dependencies/packages/checks/preflightChecker/index.ts", "--ci"],
    "notification": "Running CI Preflight",
    "status": {
      "passed": "$(check) CI Preflight passed",
      "warning": "$(warning) CI Preflight warnings",
      "failed": "$(error) CI Preflight failed"
    }
  },
  "rules": {
    "command": ["node", "dependencies/packages/checks/preflightChecker/index.ts", "--rules"],
    "autoRefresh": true,
    "notification": "Checking repository rules"
  },
  "watch": {
    "paths": ["dependencies/**", ".vscode/config/**", ".vscode/settings.json", ".github/**", "ci/**", "source/**", "rules/luau/**", ".luaurc", "tsconfig.json"],
    "setupInputs": [".vscode/config/act/actrc", "dependencies/dependencies.json", "dependencies/dependencies.lock", ".vscode/config/luau/.luaurc", ".vscode/config/typescript/tsconfig.json"]
  }
}
